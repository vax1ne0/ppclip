@@ -0,0 +1,45 @@
+import { defaultTokenFile, ensureToken } from "./config.js";
+import { DockerComputerProvider } from "./docker-provider.js";
+import { FakeComputerProvider } from "./fake-provider.js";
+import type { ComputerProvider } from "./provider.js";
+import { createSupervisorServer } from "./server.js";
+
+/** Entry point; started by scripts/ppclip/computer-supervisor.mjs. */
+const arg = (name: string, fallback?: string) => {
+  const i = process.argv.indexOf(name);
+  return i > 0 && process.argv[i + 1] && !process.argv[i + 1]!.startsWith("--") ? process.argv[i + 1]! : fallback;
+};
+
+async function main() {
+  const kind = arg("--provider", process.env.PPCLIP_COMPUTER_PROVIDER ?? "docker");
+  let provider: ComputerProvider;
+  if (kind === "fake") provider = new FakeComputerProvider();
+  else if (kind === "docker") {
+    provider = new DockerComputerProvider({
+      memoryMb: Number(arg("--memory-mb", "2048")),
+      cpus: Number(arg("--cpus", "2")),
+      maxRunning: Number(arg("--max-running", "3")),
+    });
+  } else throw new Error(`Unknown provider ${kind}. Use docker or fake.`);
+  const tokenFile = arg("--token-file", defaultTokenFile())!;
+  const supervisor = createSupervisorServer({
+    provider,
+    token: ensureToken(tokenFile),
+    host: arg("--host", "127.0.0.1"),
+    port: Number(arg("--port", "7091")),
+    allowRemote: process.argv.includes("--allow-remote"),
+  });
+  const port = await supervisor.listen();
+  console.log(`ppclip computer supervisor (${kind}) on http://${arg("--host", "127.0.0.1")}:${port}`);
+  console.log(`token file: ${tokenFile}`);
+  const shutdown = () => { void supervisor.close().then(() => process.exit(0)); };
+  process.on("SIGINT", shutdown);
+  process.on("SIGTERM", shutdown);
+}
+
+if (process.argv[1] && /supervisor[\\/]main\.(ts|js)$/.test(process.argv[1])) {
+  main().catch((err) => {
+    console.error(err instanceof Error ? err.message : err);
+    process.exit(1);
+  });
+}
diff --git a/server/src/ppclip/computer-use/supervisor/provider.ts b/server/src/ppclip/computer-use/supervisor/provider.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c4b528f430b1ca7bec7f76be79c7fda609b7a3f9
--- /dev/null
+++ b/server/src/ppclip/computer-use/supervisor/provider.ts
@@ -0,0 +1,154 @@
+/**
+ * ppclip computer use: the provider boundary used by the computer supervisor.
+ * Providers: "docker" (default, local containers), "fake" (in-memory, tests).
+ * A remote provider (E2B or similar) can implement the same interface.
+ */
+
+export type ComputerSpec = {
+  agentId: string;
+  companyId: string;
+  shell: boolean;
+  allowedHosts: string[];
+};
+
+export type ComputerInfo = {
+  agentId: string;
+  running: boolean;
+  paused: boolean;
+  /** True when a saved browser profile was found (logins survive). */
+  profileKept: boolean;
+};
+
+export type ProviderInfo = {
+  kind: "docker" | "fake" | "remote";
+  isolation: string;
+  caveats: string[];
+  liveView: boolean;
+};
+
+export type Observation = {
+  frameId: string;
+  width: number;
+  height: number;
+  /** PNG, base64. */
+  png: string;
+  url: string | null;
+  title: string | null;
+};
+
+export type ComputerAction =
+  | { type: "click"; x: number; y: number; button?: "left" | "right" | "middle"; double?: boolean }
+  | { type: "move"; x: number; y: number }
+  | { type: "drag"; x: number; y: number; toX: number; toY: number }
+  | { type: "type"; text: string }
+  | { type: "key"; key: string }
+  | { type: "scroll"; x: number; y: number; direction: "up" | "down" | "left" | "right"; amount?: number }
+  | { type: "wait"; ms: number };
+
+export type ActOptions = {
+  /** Agent explicitly confirmed an irreversible-looking click. */
+  confirm: boolean;
+  /** Regex source; clicks whose target label matches need `confirm`. */
+  irreversiblePattern: string;
+  allowedHosts: string[];
+};
+
+export type RefusalCode = "sensitive_field" | "needs_confirm" | "blocked_url" | "stale_ref" | "not_running" | "invalid";
+
+export type ActResult =
+  | { ok: true; done: number }
+  | { ok: false; code: RefusalCode; message: string; done: number };
+
+export type PageElement = {
+  ref: number;
+  tag: string;
+  role: string | null;
+  name: string;
+  inputType: string | null;
+  sensitive: boolean;
+  irreversible: boolean;
+};
+
+export type PageSnapshot = {
+  url: string | null;
+  title: string | null;
+  text: string;
+  elements: PageElement[];
+  /** Screenshot with numbered element badges (Set-of-Mark), when requested. PNG, base64. */
+  marksPng?: string;
+};
+
+export type PageAction =
+  | { type: "click"; ref: number }
+  | { type: "type"; ref: number; text: string; submit?: boolean }
+  | { type: "navigate"; url: string }
+  | { type: "back" };
+
+export type StreamUpstream = { host: string; port: number; token: string };
+
+export interface ComputerProvider {
+  describe(): ProviderInfo;
+  ensure(spec: ComputerSpec): Promise<ComputerInfo>;
+  inspect(agentId: string): Promise<ComputerInfo | null>;
+  stop(agentId: string): Promise<void>;
+  destroy(agentId: string, opts: { purgeProfile: boolean }): Promise<void>;
+  observe(agentId: string): Promise<Observation>;
+  act(agentId: string, actions: ComputerAction[], opts: ActOptions): Promise<ActResult>;
+  page(agentId: string, opts: { marks: boolean }): Promise<PageSnapshot>;
+  pageAct(agentId: string, action: PageAction, opts: ActOptions): Promise<ActResult>;
+  /** Starts (true) or kills (false) the interactive stream listener. View-only is always available. */
+  setControl(agentId: string, interactive: boolean): Promise<void>;
+  freeze(agentId: string): Promise<void>;
+  thaw(agentId: string): Promise<void>;
+  shell(agentId: string, command: string, timeoutMs: number): Promise<{ exitCode: number; output: string }>;
+  /** Where the noVNC/websockify gateway for this computer is, plus the sandbox-side token for the mode. */
+  streamUpstream(agentId: string, mode: "view" | "control"): Promise<StreamUpstream | null>;
+}
+
+export class ProviderError extends Error {
+  constructor(readonly code: RefusalCode | "unavailable" | "limit", message: string, readonly status = 409) {
+    super(message);
+  }
+}
+
+const KEY_RE = /^[A-Za-z0-9_]+(\+[A-Za-z0-9_]+)*$/;
+
+/** Validates and clamps an untrusted action list. Throws ProviderError("invalid"). */
+export function parseActions(input: unknown, screen = { width: 1280, height: 800 }, max = 16): ComputerAction[] {
+  if (!Array.isArray(input) || input.length === 0) throw new ProviderError("invalid", "actions must be a non-empty list", 400);
+  if (input.length > max) throw new ProviderError("invalid", `at most ${max} actions per call`, 400);
+  const coord = (v: unknown, limit: number) => {
+    if (typeof v !== "number" || !Number.isFinite(v)) throw new ProviderError("invalid", "coordinates must be numbers", 400);
+    return Math.min(limit - 1, Math.max(0, Math.round(v)));
+  };
+  return input.map((raw): ComputerAction => {
+    const a = (raw ?? {}) as Record<string, unknown>;
+    switch (a.type) {
+      case "click": {
+        const button = a.button === "right" || a.button === "middle" ? a.button : "left";
+        return { type: "click", x: coord(a.x, screen.width), y: coord(a.y, screen.height), button, double: a.double === true };
+      }
+      case "move":
+        return { type: "move", x: coord(a.x, screen.width), y: coord(a.y, screen.height) };
+      case "drag":
+        return { type: "drag", x: coord(a.x, screen.width), y: coord(a.y, screen.height), toX: coord(a.toX, screen.width), toY: coord(a.toY, screen.height) };
+      case "type":
+        if (typeof a.text !== "string" || a.text.length === 0 || a.text.length > 2000) throw new ProviderError("invalid", "type.text must be 1-2000 characters", 400);
+        return { type: "type", text: a.text };
+      case "key":
+        if (typeof a.key !== "string" || !KEY_RE.test(a.key) || a.key.length > 40) throw new ProviderError("invalid", "key must look like Return, ctrl+l or shift+Tab", 400);
+        return { type: "key", key: a.key };
+      case "scroll": {
+        const direction = ["up", "down", "left", "right"].includes(a.direction as string) ? (a.direction as "up") : "down";
+        const amount = typeof a.amount === "number" ? Math.min(20, Math.max(1, Math.round(a.amount))) : 3;
+        return { type: "scroll", x: coord(a.x, screen.width), y: coord(a.y, screen.height), direction, amount };
+      }
+      case "wait": {
+        const ms = typeof a.ms === "number" ? Math.min(5000, Math.max(50, Math.round(a.ms))) : 500;
+        return { type: "wait", ms };
+      }
+      default:
+        throw new ProviderError("invalid", `unknown action type ${String(a.type)}`, 400);
+    }
+  });
+}
diff --git a/server/src/ppclip/computer-use/supervisor/server.ts b/server/src/ppclip/computer-use/supervisor/server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3debc4d03300bc47a7055e1e8334af55fa6629d5
--- /dev/null
+++ b/server/src/ppclip/computer-use/supervisor/server.ts
@@ -0,0 +1,211 @@
+import http, { type IncomingMessage, type ServerResponse } from "node:http";
+import net from "node:net";
+import { timingSafeEqual } from "node:crypto";
+import { WebSocket, WebSocketServer } from "ws";
+import { ProviderError, parseActions, type ComputerProvider, type PageAction } from "./provider.js";
+
+/**
+ * ppclip computer supervisor: the only process that talks to Docker (or the
+ * remote provider). Paperclip calls it over HTTP with a bearer token. It
+ * listens on loopback only unless explicitly told otherwise.
+ *
+ * Routes (all need `Authorization: Bearer <token>`):
+ *   GET  /health
+ *   POST /computers/:agentId/ensure       {companyId, shell, allowedHosts}
+ *   GET  /computers/:agentId
+ *   POST /computers/:agentId/stop | /freeze | /thaw
+ *   DELETE /computers/:agentId?purgeProfile=1
+ *   POST /computers/:agentId/observe | /act | /page | /page/act | /control | /shell
+ *   GET  /computers/:agentId/stream/:mode/*   noVNC files and the websockify WebSocket (view | control)
+ */
+
+export type SupervisorOptions = { provider: ComputerProvider; token: string; host?: string; port?: number; allowRemote?: boolean };
+
+const LOOPBACK = new Set(["127.0.0.1", "::1", "localhost"]);
+
+function tokenMatches(header: string | undefined, token: string) {
+  const presented = header?.replace(/^Bearer\s+/i, "") ?? "";
+  const a = Buffer.from(presented);
+  const b = Buffer.from(token);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+function send(res: ServerResponse, status: number, body: unknown) {
+  const payload = JSON.stringify(body);
+  res.writeHead(status, { "content-type": "application/json", "cache-control": "no-store" });
+  res.end(payload);
+}
+
+async function readJson(req: IncomingMessage, limit = 256 * 1024): Promise<Record<string, unknown>> {
+  const chunks: Buffer[] = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += (chunk as Buffer).length;
+    if (size > limit) throw new ProviderError("invalid", "request body too large", 400);
+    chunks.push(chunk as Buffer);
+  }
+  if (!size) return {};
+  try {
+    const parsed = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    return parsed && typeof parsed === "object" ? parsed : {};
+  } catch {
+    throw new ProviderError("invalid", "invalid JSON", 400);
+  }
+}
+
+const ROUTE = /^\/computers\/([A-Za-z0-9-]{1,64})(?:\/(.*))?$/;
+const STREAM = /^stream\/(view|control)\/(.*)$/;
+const STATIC_FILE = /^[A-Za-z0-9_./-]{0,200}$/;
+
+export function createSupervisorServer(opts: SupervisorOptions) {
+  const { provider, token } = opts;
+  if (!token || token.length < 32) throw new Error("The supervisor token must be at least 32 characters.");
+  const wss = new WebSocketServer({ noServer: true, maxPayload: 8 * 1024 * 1024 });
+
+  async function handle(req: IncomingMessage, res: ServerResponse) {
+    if (!tokenMatches(req.headers.authorization, token)) return send(res, 401, { error: "unauthorized" });
+    const url = new URL(req.url ?? "/", "http://supervisor");
+    if (url.pathname === "/health" && req.method === "GET") return send(res, 200, { ok: true, provider: provider.describe() });
+    const m = ROUTE.exec(url.pathname);
+    if (!m) return send(res, 404, { error: "not found" });
+    const agentId = m[1]!;
+    const rest = m[2] ?? "";
+    const stream = STREAM.exec(rest);
+    if (stream && req.method === "GET") return proxyStatic(agentId, stream[1] as "view" | "control", stream[2]!, url.search, res);
+    const body = req.method === "POST" ? await readJson(req) : {};
+    const key = `${req.method} ${rest}`;
+    switch (key) {
+      case "POST ensure": {
+        const companyId = typeof body.companyId === "string" ? body.companyId : "";
+        const allowedHosts = Array.isArray(body.allowedHosts) ? body.allowedHosts.filter((h): h is string => typeof h === "string") : [];
+        return send(res, 200, await provider.ensure({ agentId, companyId, shell: body.shell === true, allowedHosts }));
+      }
+      case "GET ":
+        return send(res, 200, { computer: await provider.inspect(agentId) });
+      case "POST stop":
+        await provider.stop(agentId);
+        return send(res, 200, { ok: true });
+      case "POST freeze":
+        await provider.freeze(agentId);
+        return send(res, 200, { ok: true });
+      case "POST thaw":
+        await provider.thaw(agentId);
+        return send(res, 200, { ok: true });
+      case "DELETE ":
+        await provider.destroy(agentId, { purgeProfile: url.searchParams.get("purgeProfile") === "1" });
+        return send(res, 200, { ok: true });
+      case "POST observe":
+        return send(res, 200, await provider.observe(agentId));
+      case "POST act":
+        return send(res, 200, await provider.act(agentId, parseActions(body.actions), actOptions(body)));
+      case "POST page":
+        return send(res, 200, await provider.page(agentId, { marks: body.marks === true }));
+      case "POST page/act":
+        return send(res, 200, await provider.pageAct(agentId, parsePageAction(body.action), actOptions(body)));
+      case "POST control":
+        await provider.setControl(agentId, body.interactive === true);
+        return send(res, 200, { ok: true });
+      case "POST shell": {
+        if (typeof body.command !== "string" || !body.command.trim() || body.command.length > 4000) throw new ProviderError("invalid", "command must be 1-4000 characters", 400);
+        const timeoutMs = typeof body.timeoutMs === "number" ? Math.min(120_000, Math.max(1000, body.timeoutMs)) : 30_000;
+        return send(res, 200, await provider.shell(agentId, body.command, timeoutMs));
+      }
+      default:
+        return send(res, 404, { error: "not found" });
+    }
+  }
+
+  async function proxyStatic(agentId: string, mode: "view" | "control", file: string, search: string, res: ServerResponse) {
+    if (!STATIC_FILE.test(file) || file.includes("..")) return send(res, 400, { error: "bad path" });
+    const upstream = await provider.streamUpstream(agentId, mode);
+    if (!upstream) return send(res, 409, { error: mode === "control" ? "No one holds control." : "This provider has no live view." });
+    const up = await fetch(`http://${upstream.host}:${upstream.port}/${file}${search}`, { signal: AbortSignal.timeout(15_000) });
+    res.writeHead(up.status, {
+      "content-type": up.headers.get("content-type") ?? "application/octet-stream",
+      "cache-control": "no-store",
+    });
+    res.end(Buffer.from(await up.arrayBuffer()));
+  }
+
+  const server = http.createServer((req, res) => {
+    handle(req, res).catch((err: unknown) => {
+      if (err instanceof ProviderError) return send(res, err.status, { error: err.message, code: err.code });
+      return send(res, 500, { error: err instanceof Error ? err.message : "supervisor error" });
+    });
+  });
+
+  server.on("upgrade", (req, socket, head) => {
+    const fail = (status: string) => { socket.end(`HTTP/1.1 ${status}\r\nConnection: close\r\n\r\n`); };
+    if (!tokenMatches(req.headers.authorization, token)) return fail("401 Unauthorized");
+    const url = new URL(req.url ?? "/", "http://supervisor");
+    const m = ROUTE.exec(url.pathname);
+    const stream = m ? STREAM.exec(m[2] ?? "") : null;
+    if (!m || !stream || stream[2] !== "websockify") return fail("404 Not Found");
+    const agentId = m[1]!;
+    const mode = stream[1] as "view" | "control";
+    provider.streamUpstream(agentId, mode).then((upstream) => {
+      if (!upstream) return fail("409 Conflict");
+      const target = new WebSocket(`ws://${upstream.host}:${upstream.port}/websockify?token=${encodeURIComponent(upstream.token)}`, ["binary"]);
+      target.binaryType = "nodebuffer";
+      target.once("open", () => {
+        wss.handleUpgrade(req, socket, head, (client) => pipeSockets(client, target));
+      });
+      target.once("error", () => fail("502 Bad Gateway"));
+    }).catch(() => fail("502 Bad Gateway"));
+  });
+
+  return {
+    server,
+    listen() {
+      const host = opts.host ?? "127.0.0.1";
+      if (!LOOPBACK.has(host) && !opts.allowRemote) {
+        throw new Error(`Refusing to listen on ${host}: the supervisor must stay on loopback. Pass --allow-remote only for a private internal network.`);
+      }
+      return new Promise<number>((resolve, reject) => {
+        server.once("error", reject);
+        server.listen(opts.port ?? 7091, host, () => resolve((server.address() as net.AddressInfo).port));
+      });
+    },
+    close() {
+      for (const client of wss.clients) client.terminate();
+      return new Promise<void>((resolve) => server.close(() => resolve()));
+    },
+  };
+}
+
+export function pipeSockets(a: WebSocket, b: WebSocket) {
+  a.on("message", (data, isBinary) => { if (b.readyState === WebSocket.OPEN) b.send(data, { binary: isBinary }); });
+  b.on("message", (data, isBinary) => { if (a.readyState === WebSocket.OPEN) a.send(data, { binary: isBinary }); });
+  const closeBoth = () => { a.terminate(); b.terminate(); };
+  a.on("close", closeBoth);
+  b.on("close", closeBoth);
+  a.on("error", closeBoth);
+  b.on("error", closeBoth);
+}
+
+function actOptions(body: Record<string, unknown>) {
+  return {
+    confirm: body.confirm === true,
+    irreversiblePattern: typeof body.irreversiblePattern === "string" ? body.irreversiblePattern.slice(0, 2000) : "(?!)",
+    allowedHosts: Array.isArray(body.allowedHosts) ? body.allowedHosts.filter((h): h is string => typeof h === "string") : [],
+  };
+}
+
+function parsePageAction(input: unknown): PageAction {
+  const a = (input ?? {}) as Record<string, unknown>;
+  const ref = typeof a.ref === "number" && Number.isInteger(a.ref) && a.ref > 0 && a.ref < 10_000 ? a.ref : 0;
+  switch (a.type) {
+    case "click":
+      if (!ref) break;
+      return { type: "click", ref };
+    case "type":
+      if (!ref || typeof a.text !== "string" || a.text.length > 2000) break;
+      return { type: "type", ref, text: a.text, submit: a.submit === true };
+    case "navigate":
+      if (typeof a.url !== "string" || a.url.length > 2048) break;
+      return { type: "navigate", url: a.url };
+    case "back":
+      return { type: "back" };
+  }
+  throw new ProviderError("invalid", "invalid page action", 400);
+}
diff --git a/server/src/ppclip/features-routes.ts b/server/src/ppclip/features-routes.ts
