+vi.mock("@/lib/router", () => ({
+  Link: ({ children, to, ...props }: { children: ReactNode; to: string }) => <a href={to} {...props}>{children}</a>,
+  useLocation: () => ({ pathname: "/agents/all", search: "", hash: "", state: null }),
