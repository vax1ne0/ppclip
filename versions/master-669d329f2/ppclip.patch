new file mode 100644
index 0000000000000000000000000000000000000000..5266ea78c581ce834667b3640f8aaba52ce87c96
--- /dev/null
+++ b/ui/src/ppclip/attention/PendingConfirmations.tsx
@@ -0,0 +1,93 @@
+import { useMemo, useState } from "react";
+import { MessageSquareMore } from "lucide-react";
+import type { AttentionItem } from "@paperclipai/shared";
+import { Link } from "@/lib/router";
+import { Button } from "@/components/ui/button";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import { relativeTime } from "@/lib/utils";
+import { splitPendingConfirmations } from "./agent-attention";
+import { useAttentionFeed } from "./useAgentAttention";
+import { usePpclipFeature } from "@/ppclip/features/store";
+
+function CardRow({ item, onNavigate }: { item: AttentionItem; onNavigate: () => void }) {
+  const from = item.resolverAudience?.createdByAgentName ?? item.originAgentName;
+  const task = item.relatedIssue;
+  const body = (
+    <>
+      <span className="truncate text-sm font-medium">{item.subject.title ?? "Confirmation"}</span>
+      <span className="truncate text-xs text-muted-foreground">
+        {[task ? `${task.identifier ?? "Task"} · ${task.title ?? ""}` : null, from ? `from ${from}` : null]
+          .filter(Boolean)
+          .join(" — ")}
+      </span>
+      <span className="text-(length:--text-micro) text-muted-foreground/70">{relativeTime(item.activityAt)}</span>
+    </>
+  );
+  const className = "flex min-w-0 flex-col gap-0.5 rounded-md px-2 py-2 text-left no-underline text-inherit transition-colors hover:bg-accent/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring";
+  return (
+    <li>
+      {item.subject.href ? (
+        <Link to={item.subject.href} className={className} onClick={onNavigate}>{body}</Link>
+      ) : (
+        <div className={className}>{body}</div>
+      )}
+    </li>
+  );
+}
+
+function Group({ title, items, onNavigate }: { title: string; items: AttentionItem[]; onNavigate: () => void }) {
+  return (
+    <section aria-label={title} className="flex flex-col gap-1">
+      <p className="px-2 text-(length:--text-micro) font-medium uppercase tracking-widest text-muted-foreground">
+        {title} <span className="font-mono">{items.length}</span>
+      </p>
+      {items.length === 0 ? (
+        <p className="px-2 pb-1 text-xs text-muted-foreground">Nothing here.</p>
+      ) : (
+        <ul className="flex flex-col">
+          {items.map((item) => <CardRow key={item.id} item={item} onNavigate={onNavigate} />)}
+        </ul>
+      )}
+    </section>
+  );
+}
+
+/**
+ * ppclip NAV-2: open confirmation / question cards across all tasks, split by
+ * who can answer. Reads official's attention feed (the Decisions data); each
+ * row links to the card on its task, where official's resolver handles it.
+ */
+/** ppclip module switch (Settings → ppclip): attention. */
+export function PendingConfirmations(props: Parameters<typeof PendingConfirmationsContent>[0]) {
+  return usePpclipFeature("attention") ? <PendingConfirmationsContent {...props} /> : null;
+}
+
+function PendingConfirmationsContent({ companyId }: { companyId: string | null | undefined }) {
+  const [open, setOpen] = useState(false);
+  const feed = useAttentionFeed(companyId);
+  const groups = useMemo(() => splitPendingConfirmations(feed.data?.items ?? []), [feed.data]);
+  if (!companyId || !feed.data) return null;
+  const total = groups.humanOnly.length + groups.shared.length;
+  return (
+    <Popover open={open} onOpenChange={setOpen}>
+      <PopoverTrigger asChild>
+        <Button
+          type="button"
+          size="sm"
+          variant="outline"
+          aria-label={`Pending confirmations: ${total}`}
+          title="Pending confirmations"
+        >
+          <MessageSquareMore className="h-3.5 w-3.5" />
+          <span className="hidden sm:inline">Pending</span>
+          <span className="font-mono text-xs text-muted-foreground">{total}</span>
+        </Button>
+      </PopoverTrigger>
+      <PopoverContent align="end" className="flex max-h-(--sz-28rem) w-80 flex-col gap-3 overflow-y-auto p-2">
+        <p className="px-2 pt-1 text-sm font-medium">Pending confirmations</p>
+        <Group title="Needs your response" items={groups.humanOnly} onNavigate={() => setOpen(false)} />
+        <Group title="You or a teammate can respond" items={groups.shared} onNavigate={() => setOpen(false)} />
+      </PopoverContent>
+    </Popover>
+  );
+}
diff --git a/ui/src/ppclip/attention/agent-attention.test.ts b/ui/src/ppclip/attention/agent-attention.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..58eb50d9c13ce8392d3e2c04fdfd584a9946ff18
--- /dev/null
+++ b/ui/src/ppclip/attention/agent-attention.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from "vitest";
+import {
+  attentionStatusFor,
+  deriveAgentAttention,
+  orderByUrgency,
+  splitPendingConfirmations,
+  urgencyRank,
+  waitingAgentId,
+  type BlockedTaskInput,
+} from "./agent-attention";
+import { feedItem } from "./test-fixtures";
+
+const blocked = (id: string, owner: string, blockers: BlockedTaskInput["blockedBy"] = []): BlockedTaskInput => ({
+  id, identifier: id.toUpperCase(), title: `Task ${id}`, status: "blocked", assigneeAgentId: owner, blockedBy: blockers,
+});
+const blocker = (id: string, owner: string | null, status = "in_progress") => ({
+  id, identifier: id.toUpperCase(), title: `Task ${id}`, status, assigneeAgentId: owner,
+});
+
+describe("waitingAgentId", () => {
+  it("treats human-only interactions (and legacy board_only) as waiting for a person", () => {
+    expect(waitingAgentId(feedItem({ policy: "human_only" }))).toBe("agent-a");
+    expect(waitingAgentId(feedItem({ policy: "board_only" }))).toBe("agent-a");
+  });
+  it("ignores cards a teammate could answer", () => {
+    expect(waitingAgentId(feedItem({ policy: "anyone" }))).toBeNull();
+    expect(waitingAgentId(feedItem({ policy: "not_creator" }))).toBeNull();
+    expect(waitingAgentId(feedItem({ policy: null }))).toBeNull();
+  });
+  it("counts a pending approval against the agent that requested it", () => {
+    const item = feedItem({ sourceKind: "approval" });
+    item.subject.metadata = { requestedByAgentId: "agent-b" };
+    expect(waitingAgentId(item)).toBe("agent-b");
+  });
+  it("ignores other feed sources", () => {
+    expect(waitingAgentId(feedItem({ sourceKind: "failed_run" }))).toBeNull();
+  });
+});
+
+describe("deriveAgentAttention", () => {
+  it("splits blocked tasks into pending on another agent vs blocked for other reasons", () => {
+    const result = deriveAgentAttention([], [
+      blocked("t1", "agent-a", [blocker("b1", "agent-b")]),
+      blocked("t2", "agent-c", [blocker("b2", "agent-c")]), // own task: not waiting on another agent
+      blocked("t3", "agent-d", [blocker("b3", "agent-b", "done")]), // finished blocker
+      blocked("t4", "agent-e", [{ ...blocker("b4", null), terminalBlockers: [blocker("b5", "agent-b")] }]),
+    ]);
+    expect(result.get("agent-a")?.dependencies.map((d) => [d.blocker.id, d.blockerAgentId])).toEqual([["b1", "agent-b"]]);
+    expect(result.get("agent-c")?.blockedTasks.map((t) => t.id)).toEqual(["t2"]);
+    expect(result.get("agent-d")?.blockedTasks.map((t) => t.id)).toEqual(["t3"]);
+    expect(result.get("agent-e")?.dependencies.map((d) => d.blocker.id)).toEqual(["b5"]);
+  });
+
+  it("collects waiting items with their task", () => {
+    const result = deriveAgentAttention([feedItem({})], []);
+    expect(result.get("agent-a")?.waiting).toEqual([
+      expect.objectContaining({ kind: "interaction", title: "Ship it?", task: { id: "issue-1", identifier: "PAP-1", title: "Launch" } }),
+    ]);
+  });
+});
+
+describe("attentionStatusFor", () => {
+  const attention = deriveAgentAttention([feedItem({})], [
+    blocked("t1", "agent-a", [blocker("b1", "agent-b")]),
+    blocked("t2", "agent-b"),
+    blocked("t3", "agent-c", [blocker("b3", "agent-b")]),
+  ]);
+  it("ranks waiting for you over pending on agent over blocked task", () => {
+    expect(attentionStatusFor({ status: "idle" }, attention.get("agent-a"))).toBe("waiting_for_you");
+    expect(attentionStatusFor({ status: "idle" }, attention.get("agent-c"))).toBe("pending_on_agent");
+    expect(attentionStatusFor({ status: "active" }, attention.get("agent-b"))).toBe("blocked_task");
+    expect(attentionStatusFor({ status: "idle" }, undefined)).toBeNull();
+  });
+  it("keeps official running, error and paused states", () => {
+    for (const status of ["running", "error", "paused", "pending_approval"] as const) {
+      expect(attentionStatusFor({ status }, attention.get("agent-a"))).toBeNull();
+    }
+  });
+});
+
+describe("urgency ordering", () => {
+  const attention = deriveAgentAttention([feedItem({ createdBy: "wait" })], [
+    blocked("t1", "pend", [blocker("b1", "other")]),
+    blocked("t2", "block"),
+  ]);
+  const agents = [
+    { id: "idle", status: "idle", pauseReason: null },
+    { id: "block", status: "idle", pauseReason: null },
+    { id: "err", status: "error", pauseReason: null },
+    { id: "pend", status: "idle", pauseReason: null },
+    { id: "budget", status: "paused", pauseReason: "budget" },
+    { id: "live", status: "idle", pauseReason: null },
+    { id: "wait", status: "idle", pauseReason: null },
+    { id: "run", status: "running", pauseReason: null },
+    { id: "paused", status: "paused", pauseReason: "manual" },
+  ];
+  const live = new Map([["live", 1]]);
+  const rank = (agent: (typeof agents)[number]) => urgencyRank(agent as never, live.get(agent.id) ?? 0, attention.get(agent.id));
+
+  it("puts running before waiting/pending before blocked/error before idle, stable within groups", () => {
+    expect(orderByUrgency(agents, rank).map((a) => a.id)).toEqual([
+      "live", "run", // running
+      "pend", "wait", // waiting / pending, in the caller's order
+      "block", "err", "budget", // blocked / error / budget-paused
+      "idle", "paused", // idle and everything else
+    ]);
+  });
+
+  it("does not reorder an all-idle list", () => {
+    const idle = [{ id: "c" }, { id: "a" }, { id: "b" }];
+    expect(orderByUrgency(idle, () => 3).map((a) => a.id)).toEqual(["c", "a", "b"]);
+  });
+});
+
+describe("splitPendingConfirmations", () => {
+  it("lists only confirmation/question cards, human-only first group, newest first", () => {
+    const older = feedItem({ policy: "human_only", activityAt: "2026-10-01T00:00:00.000Z" });
+    const newer = feedItem({ policy: "human_only", activityAt: "2026-10-02T00:00:00.000Z", kind: "ask_user_questions" });
+    const shared = feedItem({ policy: "anyone", kind: "request_checkbox_confirmation" });
+    const notCard = feedItem({ kind: "suggest_tasks" });
+    const approval = feedItem({ sourceKind: "approval" });
+    const groups = splitPendingConfirmations([older, shared, newer, notCard, approval]);
+    expect(groups.humanOnly).toEqual([newer, older]);
+    expect(groups.shared).toEqual([shared]);
+  });
+});
diff --git a/ui/src/ppclip/attention/agent-attention.ts b/ui/src/ppclip/attention/agent-attention.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e05ad4514181d2a03d9e146b1f2d59a42bb667a8
--- /dev/null
+++ b/ui/src/ppclip/attention/agent-attention.ts
@@ -0,0 +1,217 @@
+import type { Agent, AttentionItem } from "@paperclipai/shared";
+
+/**
+ * ppclip NAV-2: agent attention statuses derived from official data only.
+ *
+ *   waiting_for_you   the agent opened a decision only a person can answer: a
+ *                     pending issue-thread interaction whose server-evaluated
+ *                     resolver policy is `human_only` (legacy `board_only`), or
+ *                     a pending board approval it requested. Read from the
+ *                     official attention feed (the Decisions data).
+ *   pending_on_agent  one of its blocked tasks waits on another agent's open
+ *                     task (official `blockedBy` relations, incl. terminal blockers).
+ *   blocked_task      one of its tasks is blocked for any other reason.
+ *
+ * Official's own states win where they say more: running, error, paused and
+ * pending approval are never replaced.
+ */
+export type AttentionStatus = "waiting_for_you" | "pending_on_agent" | "blocked_task";
+
+export const ATTENTION_LABELS: Record<AttentionStatus, string> = {
+  waiting_for_you: "Waiting for you",
+  pending_on_agent: "Pending on agent",
+  blocked_task: "Blocked task",
+};
+
+export type TaskRef = { id: string; identifier: string | null; title: string };
+
+export type WaitingItem = {
+  id: string;
+  kind: "interaction" | "approval";
+  title: string;
+  href: string | null;
+  task: TaskRef | null;
+};
+
+export type AgentDependency = {
+  /** The agent's blocked task. */
+  task: TaskRef;
+  /** The other agent's open task it waits on. */
+  blocker: TaskRef;
+  blockerAgentId: string;
+};
+
+export type AgentAttention = {
+  waiting: WaitingItem[];
+  dependencies: AgentDependency[];
+  /** Blocked tasks that do not wait on another agent. */
+  blockedTasks: TaskRef[];
+};
+
+export const EMPTY_ATTENTION: AgentAttention = { waiting: [], dependencies: [], blockedTasks: [] };
+
+/** Minimal blocked-task shape (official `Issue` with `includeBlockedBy`). */
+export type BlockedTaskInput = {
+  id: string;
+  identifier?: string | null;
+  title: string;
+  status: string;
+  assigneeAgentId?: string | null;
+  blockedBy?: BlockerInput[] | null;
+};
+type BlockerInput = {
+  id: string;
+  identifier?: string | null;
+  title: string;
+  status: string;
+  assigneeAgentId?: string | null;
+  terminalBlockers?: BlockerInput[] | null;
+};
+
+const FINISHED = new Set(["done", "cancelled"]);
+const ref = (task: { id: string; identifier?: string | null; title: string }): TaskRef => ({
+  id: task.id,
+  identifier: task.identifier ?? null,
+  title: task.title,
+});
+
+/** Canonical resolver policy for a feed row (`board_only` is the legacy alias of `human_only`). */
+export function interactionResolverPolicy(item: AttentionItem): "anyone" | "not_creator" | "human_only" {
+  const policy = item.resolverAudience?.effectiveResolverPolicy as string | undefined;
+  if (policy === "human_only" || policy === "board_only") return "human_only";
+  if (policy === "not_creator") return "not_creator";
+  return "anyone";
+}
+
+function metadataString(item: AttentionItem, key: string): string | null {
+  const value = item.subject.metadata?.[key];
+  return typeof value === "string" && value.length > 0 ? value : null;
+}
+
+/** The agent that is waiting on this feed row, when only a person can answer it. */
+export function waitingAgentId(item: AttentionItem): string | null {
+  if (item.sourceKind === "issue_thread_interaction") {
+    if (interactionResolverPolicy(item) !== "human_only") return null;
+    return item.resolverAudience?.createdByAgentId ?? metadataString(item, "createdByAgentId");
+  }
+  if (item.sourceKind === "approval") return metadataString(item, "requestedByAgentId");
+  return null;
+}
+
+function relatedTask(item: AttentionItem): TaskRef | null {
+  const issue = item.relatedIssue;
+  if (!issue) return null;
+  return { id: issue.id, identifier: issue.identifier, title: issue.title ?? issue.identifier ?? "Task" };
+}
+
+/** Per-agent attention from the attention feed and the company's blocked tasks. */
+export function deriveAgentAttention(
+  feedItems: readonly AttentionItem[],
+  blockedTasks: readonly BlockedTaskInput[],
+): Map<string, AgentAttention> {
+  const result = new Map<string, AgentAttention>();
+  const entry = (agentId: string) => {
+    let value = result.get(agentId);
+    if (!value) {
+      value = { waiting: [], dependencies: [], blockedTasks: [] };
+      result.set(agentId, value);
+    }
+    return value;
+  };
+
+  for (const item of feedItems) {
+    const agentId = waitingAgentId(item);
+    if (!agentId) continue;
+    entry(agentId).waiting.push({
+      id: item.id,
+      kind: item.sourceKind === "approval" ? "approval" : "interaction",
+      title: item.subject.title ?? "Decision",
+      href: item.subject.href,
+      task: relatedTask(item),
+    });
+  }
+
+  for (const task of blockedTasks) {
+    const owner = task.assigneeAgentId;
+    if (!owner || task.status !== "blocked") continue;
+    const seen = new Set<string>();
+    const dependencies: AgentDependency[] = [];
+    for (const relation of task.blockedBy ?? []) {
+      for (const blocker of [relation, ...(relation.terminalBlockers ?? [])]) {
+        if (seen.has(blocker.id) || blocker.id === task.id) continue;
+        seen.add(blocker.id);
+        if (FINISHED.has(blocker.status) || !blocker.assigneeAgentId || blocker.assigneeAgentId === owner) continue;
+        dependencies.push({ task: ref(task), blocker: ref(blocker), blockerAgentId: blocker.assigneeAgentId });
+      }
+    }
+    if (dependencies.length > 0) entry(owner).dependencies.push(...dependencies);
+    else entry(owner).blockedTasks.push(ref(task));
+  }
+  return result;
+}
+
+/** Official states that already say more than a derived attention status. */
+const OFFICIAL_WINS = new Set(["running", "error", "paused", "pending_approval", "terminated"]);
+
+/** The derived status to show for an agent, or null to keep official's status. */
+export function attentionStatusFor(
+  agent: Pick<Agent, "status">,
+  attention: AgentAttention | undefined,
+): AttentionStatus | null {
+  if (!attention || OFFICIAL_WINS.has(agent.status)) return null;
+  if (attention.waiting.length > 0) return "waiting_for_you";
+  if (attention.dependencies.length > 0) return "pending_on_agent";
+  if (attention.blockedTasks.length > 0) return "blocked_task";
+  return null;
+}
+
+/**
+ * NAV-1 urgency bucket: 0 running/live, 1 waiting or pending, 2 blocked or
+ * erroring (incl. budget-paused), 3 idle and everything else.
+ */
+export function urgencyRank(
+  agent: Pick<Agent, "status" | "pauseReason">,
+  liveRuns: number,
+  attention: AgentAttention | undefined,
+): number {
+  if (liveRuns > 0 || agent.status === "running") return 0;
+  if (agent.status === "pending_approval") return 1;
+  if (agent.status === "error" || (agent.status === "paused" && agent.pauseReason === "budget")) return 2;
+  if (agent.status === "paused" || agent.status === "terminated") return 3;
+  if (attention?.waiting.length || attention?.dependencies.length) return 1;
+  if (attention?.blockedTasks.length) return 2;
+  return 3;
+}
+
+/** Stable sort by urgency: within a bucket the caller's existing order is kept. */
+export function orderByUrgency<T extends { id: string }>(agents: readonly T[], rankOf: (agent: T) => number): T[] {
+  return agents
+    .map((agent, index) => ({ agent, index, rank: rankOf(agent) }))
+    .sort((a, b) => a.rank - b.rank || a.index - b.index)
+    .map((entry) => entry.agent);
+}
+
+/** Confirmation / question cards listed by the Pending confirmations popover. */
+export const CONFIRMATION_CARD_KINDS = new Set([
+  "request_confirmation",
+  "request_checkbox_confirmation",
+  "request_item_verdicts",
+  "ask_user_questions",
+]);
+
+export function isConfirmationCard(item: AttentionItem): boolean {
+  if (item.sourceKind !== "issue_thread_interaction") return false;
+  const kind = item.subject.metadata?.kind;
+  return typeof kind === "string" && CONFIRMATION_CARD_KINDS.has(kind);
+}
+
+/** Open cards split by who can answer them, newest first within each group. */
+export function splitPendingConfirmations(items: readonly AttentionItem[]) {
+  const cards = items
+    .filter(isConfirmationCard)
+    .sort((a, b) => b.activityAt.localeCompare(a.activityAt));
+  return {
+    humanOnly: cards.filter((item) => interactionResolverPolicy(item) === "human_only"),
+    shared: cards.filter((item) => interactionResolverPolicy(item) !== "human_only"),
+  };
+}
