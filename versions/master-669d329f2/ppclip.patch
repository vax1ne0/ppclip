+    const client = new QueryClient();
+    const keys = [
+      ["live-runs", "c1"],
+      ["live-runs", "c1", "dashboard", { minRunCount: 4 }],
+      ["live-runs", "c1", "dashboard-live", { minRunCount: 50 }],
+      ["live-runs", "c2", "dashboard", { minRunCount: 4 }],
+      ["issues", "live-runs", "c1"],
