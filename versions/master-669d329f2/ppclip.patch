@@ -0,0 +1,27 @@
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { runControlsApi } from "./api";
+
+export const runControlsQueryKey = (companyId: string | null | undefined) =>
+  ["ppclip", "run-controls", companyId ?? null] as const;
+
+/** The company's run-control state; `enabled` stays false until the master switch is on. */
+export function useRunControls(companyId: string | null | undefined) {
+  return useQuery({
+    queryKey: runControlsQueryKey(companyId),
+    queryFn: () => runControlsApi.overview(companyId!),
+    enabled: !!companyId,
+    refetchInterval: 15_000,
+    staleTime: 5_000,
+  });
+}
+
+/** Run controls rewrite agents' configs, so refresh the overview and every agent cache. */
+export function useInvalidateRunControls(companyId: string | null | undefined) {
+  const queryClient = useQueryClient();
+  return async () => {
+    await Promise.all([
+      queryClient.invalidateQueries({ queryKey: runControlsQueryKey(companyId) }),
+      queryClient.invalidateQueries({ queryKey: ["agents"] }),
+    ]);
+  };
+}
diff --git a/ui/src/ppclip/task-chat-run-activity.test.ts b/ui/src/ppclip/task-chat-run-activity.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4c8d674c28c749df54e665be5990a76e162e4a6f
--- /dev/null
+++ b/ui/src/ppclip/task-chat-run-activity.test.ts
@@ -0,0 +1,232 @@
+import { describe, expect, it } from "vitest";
+import type {
+  TaskChatItem,
+  TaskChatTurnItem,
+} from "@/components/task-chat/task-chat-model";
+import type { SettledTurnMergeMeta } from "@/components/task-chat/transcript-adapter";
+import type { IssueChatComment } from "@/lib/issue-chat-messages";
+import {
+  arrangeRunActivity,
+  firstReplyCommentIdByRun,
+  isRunForThisTask,
+  placeTurnsBelowReplies,
+  markFollowUpRuns,
+  runsForThisTask,
+  turnRunId,
+} from "./task-chat-run-activity";
+import { isSameRunAgent } from "./task-chat-same-agent";
+
+describe("isRunForThisTask / runsForThisTask (CHAT-3)", () => {
+  it("keeps runs started for this task and runs with no task context", () => {
+    expect(isRunForThisTask({ contextIssueId: "task-b" }, "task-b")).toBe(true);
+    expect(isRunForThisTask({ contextIssueId: null }, "task-b")).toBe(true);
+    expect(isRunForThisTask({}, "task-b")).toBe(true);
+    expect(isRunForThisTask({ contextIssueId: "" }, "task-b")).toBe(true);
+  });
+
+  it("drops runs started for a different task", () => {
+    expect(isRunForThisTask({ contextIssueId: "task-a" }, "task-b")).toBe(false);
+  });
+
+  it("does not filter when the chat has no task id", () => {
+    expect(isRunForThisTask({ contextIssueId: "task-a" }, null)).toBe(true);
+    const runs = [{ contextIssueId: "task-a" }];
+    expect(runsForThisTask(runs, undefined)).toBe(runs);
+  });
+
+  it("returns the same array when nothing is dropped and filters otherwise", () => {
+    const own = [{ runId: "1", contextIssueId: "task-b" }, { runId: "2", contextIssueId: null }];
+    expect(runsForThisTask(own, "task-b")).toBe(own);
+    const mixed = [...own, { runId: "3", contextIssueId: "task-a" }];
+    expect(runsForThisTask(mixed, "task-b")?.map((run) => run.runId)).toEqual(["1", "2"]);
+    expect(runsForThisTask(undefined, "task-b")).toBeUndefined();
+  });
+});
+
+function comment(
+  id: string,
+  createdAt: string,
+  extra: Partial<IssueChatComment> = {},
+): IssueChatComment {
+  return {
+    id,
+    companyId: "company",
+    issueId: "issue",
+    authorType: "agent",
+    authorAgentId: "agent-1",
+    authorUserId: null,
+    body: id,
+    createdAt: new Date(createdAt),
+    updatedAt: new Date(createdAt),
+    ...extra,
+  } as IssueChatComment;
+}
+
+describe("firstReplyCommentIdByRun (CHAT-4 anchoring)", () => {
+  it("anchors each run to its earliest reply regardless of input order", () => {
+    const map = firstReplyCommentIdByRun([
+      comment("late", "2025-01-01T10:00:30Z", { runId: "run-1" }),
+      comment("early", "2025-01-01T10:00:10Z", { runId: "run-1" }),
+      comment("other", "2025-01-01T10:00:20Z", { runId: "run-2" }),
+    ]);
+    expect(map.get("run-1")).toBe("early");
+    expect(map.get("run-2")).toBe("other");
+  });
+
+  it("uses recovered run attribution and skips deleted and system comments", () => {
+    const map = firstReplyCommentIdByRun([
+      comment("deleted", "2025-01-01T10:00:01Z", { runId: "run-1", deletedAt: new Date() }),
+      comment("notice", "2025-01-01T10:00:02Z", { runId: "run-1", authorType: "system" }),
+      comment("stored", "2025-01-01T10:00:03Z", { createdByRunId: "run-1" }),
+      comment("derived", "2025-01-01T10:00:04Z", { derivedCreatedByRunId: "run-2" }),
+      comment("human", "2025-01-01T10:00:05Z", { authorType: "user", authorAgentId: null }),
+    ]);
+    expect(map.get("run-1")).toBe("stored");
+    expect(map.get("run-2")).toBe("derived");
+    expect(map.size).toBe(2);
+  });
+
+  it("leaves a steered run unanchored, like official", () => {
+    const map = firstReplyCommentIdByRun([
+      comment("reply", "2025-01-01T10:00:10Z", { runId: "run-1" }),
+      comment("steer", "2025-01-01T10:00:05Z", {
+        authorType: "user",
+        authorAgentId: null,
+        steeredIntoRunId: "run-1",
+        conversationAnchorAt: "2025-01-01T10:00:06Z",
+      }),
+    ]);
+    expect(map.has("run-1")).toBe(false);
+  });
+});
+
+describe("isSameRunAgent (CHAT-4)", () => {
+  it("prefers ids, falls back to non-empty names", () => {
+    expect(isSameRunAgent({ agentKey: "a", agentName: "CEO" }, { agent: { id: "b" }, authorName: "CEO" })).toBe(false);
+    expect(isSameRunAgent({ agentKey: "a" }, { agent: { id: "a" } })).toBe(true);
+    expect(isSameRunAgent({ agentKey: "", agentName: "CEO" }, { authorName: "CEO" })).toBe(true);
+    expect(isSameRunAgent({ agentKey: "", agentName: "CEO" }, { authorName: "QA" })).toBe(false);
+    expect(isSameRunAgent({ agentKey: "a" }, { authorName: "CEO" })).toBe(false);
+    expect(isSameRunAgent({ agentKey: "" }, {})).toBe(false);
+    expect(isSameRunAgent(undefined, { agent: { id: "a" } })).toBe(false);
+  });
+});
+
+const summary = { toolCount: 1, added: 0, removed: 0 };
+function turn(id: string, extra: Partial<TaskChatTurnItem> = {}): TaskChatTurnItem {
+  return { id, kind: "turn", settled: true, items: [], summary, ...extra };
+}
+function reply(id: string, agentId = "agent-1"): TaskChatItem {
+  return { id, kind: "message", author: "agent", authorName: "CEO", agent: { id: agentId }, text: id };
+}
+function human(id: string): TaskChatItem {
+  return { id, kind: "message", author: "human", text: id };
+}
+function meta(agentKey: string): SettledTurnMergeMeta {
+  return { agentKey, agentName: "CEO", parts: [] };
+}
+const ids = (items: readonly TaskChatItem[]) => items.map((item) => item.id);
+
+describe("turnRunId", () => {
+  it("strips the turn suffix and segment index", () => {
+    expect(turnRunId("run-1:turn")).toBe("run-1");
+    expect(turnRunId("run-1:turn:2")).toBe("run-1");
+  });
+});
+
+describe("placeTurnsBelowReplies", () => {
+  const runs = new Map([["c1", "run-1"], ["c1b", "run-1"]]);
+
+  it("moves an anchored turn directly below its run's last reply", () => {
+    const out = placeTurnsBelowReplies(
+      [human("ask"), turn("run-1:turn"), reply("c1"), reply("c1b"), human("next")],
+      new Map([["run-1:turn", "c1"]]),
+      runs,
+    );
+    expect(ids(out)).toEqual(["ask", "c1", "c1b", "run-1:turn", "next"]);
+  });
+
+  it("leaves a turn in place when its reply is not in the thread", () => {
+    const out = placeTurnsBelowReplies(
+      [human("ask"), turn("run-1:turn")],
+      new Map([["run-1:turn", "missing"]]),
+      runs,
+    );
+    expect(ids(out)).toEqual(["ask", "run-1:turn"]);
+  });
+});
+
+describe("markFollowUpRuns", () => {
+  const metaById = new Map([
+    ["run-1:turn", meta("agent-1")],
+    ["run-2:turn", meta("agent-1")],
+    ["run-3:turn", meta("agent-2")],
+  ]);
+  const runByComment = new Map([
+    ["c1", "run-1"],
+    ["c2", "run-2"],
+    ["c3", "run-3"],
+  ]);
+
+  it("divides consecutive separate runs of the same agent", () => {
+    const out = markFollowUpRuns(
+      [human("ask"), turn("run-1:turn"), reply("c1"), turn("run-2:turn"), reply("c2")],
+      metaById,
+      runByComment,
+    );
+    expect(ids(out)).toEqual(["ask", "run-1:turn", "c1", "run-2:ppclip-follow-up", "run-2:turn", "c2"]);
+    const marker = out[3] as Extract<TaskChatItem, { kind: "marker" }>;
+    expect(marker).toMatchObject({ variant: "turn_boundary", label: "Follow-up run" });
+  });
+
+  it("does not divide segments of one run, other agents, or exchanges split by a human", () => {
+    expect(
+      ids(markFollowUpRuns(
+        [turn("run-1:turn:0"), reply("c1"), turn("run-1:turn:1")],
+        new Map([["run-1:turn:0", meta("agent-1")], ["run-1:turn:1", meta("agent-1")]]),
+        runByComment,
+      )),
+    ).toEqual(["run-1:turn:0", "c1", "run-1:turn:1"]);
+    expect(
+      ids(markFollowUpRuns([reply("c1"), turn("run-3:turn"), reply("c3", "agent-2")], metaById, runByComment)),
+    ).toEqual(["c1", "run-3:turn", "c3"]);
+    expect(
+      ids(markFollowUpRuns([reply("c1"), human("again"), reply("c2")], metaById, runByComment)),
+    ).toEqual(["c1", "again", "c2"]);
+  });
+});
+
+describe("arrangeRunActivity", () => {
+  it("keeps separate Worked rows below their replies and never attaches classic activity", () => {
+    const run1 = turn("run-1:turn");
+    const run2 = turn("run-2:turn");
+    const out = arrangeRunActivity(
+      [human("ask"), reply("c1"), run1, reply("c2"), run2],
+      {
+        settledTurns: [
+          { turn: run1, anchorCommentId: "c1" },
+          { turn: run2, anchorCommentId: "c2" },
+        ],
+        metaById: new Map([["run-1:turn", meta("agent-1")], ["run-2:turn", meta("agent-1")]]),
+        comments: [
+          comment("c1", "2025-01-01T10:00:10Z", { runId: "run-1" }),
+          comment("c2", "2025-01-01T10:01:10Z", { runId: "run-2" }),
+        ],
+      },
+    );
+    expect(ids(out)).toEqual(["ask", "c1", "run-1:turn", "run-2:ppclip-follow-up", "c2", "run-2:turn"]);
+    expect(out.every((item) => item.kind !== "message" || item.attachedTurn == null)).toBe(true);
+  });
+
+  it("still attaches a Paperclip Runner turn to its own reply", () => {
+    const runner = turn("run-1:turn", { standaloneHeader: true });
+    const out = arrangeRunActivity([human("ask"), reply("c1"), runner], {
+      settledTurns: [{ turn: runner, anchorCommentId: "c1" }],
+      metaById: new Map([["run-1:turn", meta("agent-1")]]),
+      comments: [comment("c1", "2025-01-01T10:00:10Z", { runId: "run-1" })],
+    });
+    expect(ids(out)).toEqual(["ask", "c1"]);
+    const bubble = out[1] as Extract<TaskChatItem, { kind: "message" }>;
+    expect(bubble.attachedTurn?.id).toBe("run-1:turn");
+  });
+});
diff --git a/ui/src/ppclip/task-chat-run-activity.ts b/ui/src/ppclip/task-chat-run-activity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..579dc22164bef9160db1c41d977bd26c5ade2039
--- /dev/null
+++ b/ui/src/ppclip/task-chat-run-activity.ts
@@ -0,0 +1,260 @@
+import type { IssueChatComment } from "@/lib/issue-chat-messages";
+import type {
+  TaskChatItem,
+  TaskChatMarkerItem,
+  TaskChatTurnItem,
+} from "@/components/task-chat/task-chat-model";
+import {
+  attachSettledTurns,
+  type SettledTurnMergeMeta,
+} from "@/components/task-chat/transcript-adapter";
+
+/**
+ * ppclip CHAT-3: a task chat shows a run's activity (thinking, tools, Worked
+ * row, run status) only when the run was started for this task.
+ *
+ * Official "runs for this issue" also returns runs that merely wrote to the
+ * issue while executing another task (contextIssueId = that other task). Their
+ * comments still appear here; their transcript belongs to the other task.
+ * Runs with no task context at all (Agent Chat, timer/heartbeat runs) stay
+ * visible: they did act here and have no other task chat to show up in.
+ */
+export function isRunForThisTask(
+  run: { contextIssueId?: string | null },
+  issueId: string | null | undefined,
+): boolean {
+  if (!issueId) return true;
+  const contextIssueId = run.contextIssueId;
+  return !contextIssueId || contextIssueId === issueId;
+}
+
+/** Filters linked runs for this task chat, keeping the input reference when nothing is dropped. */
+export function runsForThisTask<T extends { contextIssueId?: string | null }>(
+  runs: T[] | undefined,
+  issueId: string | null | undefined,
+): T[] | undefined {
+  if (!runs || !issueId) return runs;
+  if (runs.every((run) => isRunForThisTask(run, issueId))) return runs;
+  return runs.filter((run) => isRunForThisTask(run, issueId));
+}
+
+type RunReplyComment = Pick<
+  IssueChatComment,
+  | "id"
+  | "createdAt"
+  | "deletedAt"
+  | "authorType"
+  | "runId"
+  | "createdByRunId"
+  | "derivedCreatedByRunId"
+  | "steeredIntoRunId"
+  | "conversationAnchorAt"
+>;
+
+/**
+ * The run that wrote a comment. Stored provenance first (as the official
+ * task-chat adapter does), then the activity-derived run id, then recovered
+ * attribution for replies posted through the API.
+ */
+export function commentRunId(comment: RunReplyComment): string | null {
+  return (
+    comment.createdByRunId ??
+    comment.runId ??
+    comment.derivedCreatedByRunId ??
+    null
+  );
+}
+
+function toMs(value: Date | string | null | undefined): number {
+  if (!value) return 0;
+  const ms = value instanceof Date ? value.getTime() : Date.parse(value);
+  return Number.isFinite(ms) ? ms : 0;
+}
+
+/**
+ * ppclip CHAT-4 anchoring: each run's activity anchors to the run's FIRST reply
+ * (by creation time), not the last. The Worked row is shown above the answer,
+ * so the first reply is where the run's visible output starts; anchoring to the
+ * last reply split a multi-reply run around its own activity. Recovered run
+ * links (createdByRunId / derivedCreatedByRunId) count, so API-posted replies
+ * get their activity too. System notices never own a run's activity. As in
+ * official, a run steered mid-turn stays unanchored so its segments interleave
+ * around the injected human message.
+ */
+export function firstReplyCommentIdByRun(
+  comments: readonly RunReplyComment[],
+): Map<string, string> {
+  const map = new Map<string, string>();
+  const ordered = comments
+    .map((comment, index) => ({ comment, index }))
+    .sort(
+      (a, b) =>
+        toMs(a.comment.createdAt) - toMs(b.comment.createdAt) ||
+        a.index - b.index,
+    );
+  for (const { comment } of ordered) {
+    if (comment.deletedAt || !comment.id || comment.authorType === "system")
+      continue;
+    const runId = commentRunId(comment);
+    if (!runId || map.has(runId)) continue;
+    map.set(runId, comment.id);
+  }
+  for (const comment of comments) {
+    const runId = comment.steeredIntoRunId;
+    if (!comment.deletedAt && runId && comment.conversationAnchorAt) {
+      map.delete(runId);
+    }
+  }
+  return map;
+}
+
+/** Run id of a settled turn item (`<runId>:turn` or `<runId>:turn:<segment>`). */
+export function turnRunId(turnId: string): string {
+  return turnId.replace(/:turn(?::\d+)?$/, "");
+}
+
+export const FOLLOW_UP_RUN_LABEL = "Follow-up run";
+export const FOLLOW_UP_RUN_DETAIL = "A separate execution by this agent";
+
+/**
+ * Owner choice: classic (non-runner) activity anchored to a run's reply moves
+ * directly BELOW that run's last reply in the thread, so the answer reads
+ * first and the "Worked" row follows it as its own row (the reply keeps its
+ * timestamp/actions footer). A run that posted several replies keeps them
+ * together, with its activity after the last one.
+ */
+export function placeTurnsBelowReplies(
+  items: readonly TaskChatItem[],
+  replyIdByTurnId: ReadonlyMap<string, string>,
+  runIdByCommentId: ReadonlyMap<string, string>,
+): TaskChatItem[] {
+  if (replyIdByTurnId.size === 0) return [...items];
+  const presentIds = new Set(items.map((item) => item.id));
+  // The last reply of each run, in thread order.
+  const lastReplyIdByRun = new Map<string, string>();
+  for (const item of items) {
+    if (item.kind === "turn") continue;
+    const runId = runIdByCommentId.get(item.id);
+    if (runId) lastReplyIdByRun.set(runId, item.id);
+  }
+  const movedByReply = new Map<string, TaskChatItem[]>();
+  const rest: TaskChatItem[] = [];
+  for (const item of items) {
+    const anchorId =
+      item.kind === "turn" ? replyIdByTurnId.get(item.id) : undefined;
+    const runId = anchorId ? runIdByCommentId.get(anchorId) : undefined;
+    const target = (runId && lastReplyIdByRun.get(runId)) ?? anchorId;
+    if (target && presentIds.has(target)) {
+      const list = movedByReply.get(target) ?? [];
+      list.push(item);
+      movedByReply.set(target, list);
+      continue;
+    }
+    rest.push(item);
+  }
+  const out: TaskChatItem[] = [];
+  for (const item of rest) {
+    out.push(item);
+    const moved = movedByReply.get(item.id);
+    if (moved) out.push(...moved);
+  }
+  return out;
+}
+
+/**
+ * Separate runs of the same agent that follow each other with nothing but that
+ * agent's own output between them get a quiet "Follow-up run" divider instead
+ * of being merged into one Worked row. A human message, interaction, marker or
+ * another agent ends the sequence.
+ */
+export function markFollowUpRuns(
+  items: readonly TaskChatItem[],
+  metaById: ReadonlyMap<string, SettledTurnMergeMeta>,
+  runIdByCommentId: ReadonlyMap<string, string>,
+): TaskChatItem[] {
+  const out: TaskChatItem[] = [];
+  let previous: { agentId: string; runId: string } | null = null;
+  for (const item of items) {
+    let owner: { agentId: string; runId: string } | null = null;
+    if (item.kind === "turn") {
+      const agentId = metaById.get(item.id)?.agentKey;
+      if (agentId) owner = { agentId, runId: turnRunId(item.id) };
+    } else if (item.kind === "message" && item.author === "agent") {
+      if (item.interstitial) {
+        out.push(item);
+        continue;
+      }
+      const agentId = item.agent?.id;
+      const runId = item.attachedTurn
+        ? turnRunId(item.attachedTurn.id)
+        : runIdByCommentId.get(item.id);
+      if (agentId && runId) owner = { agentId, runId };
+    }
+    if (
+      owner &&
+      previous &&
+      previous.agentId === owner.agentId &&
+      previous.runId !== owner.runId
+    ) {
+      const marker: TaskChatMarkerItem = {
+        id: `${owner.runId}:ppclip-follow-up`,
+        kind: "marker",
+        variant: "turn_boundary",
+        label: FOLLOW_UP_RUN_LABEL,
+        detail: FOLLOW_UP_RUN_DETAIL,
+      };
+      out.push(marker);
+    }
+    previous = owner;
+    out.push(item);
+  }
+  return out;
+}
+
+/**
+ * ppclip CHAT-4 final assembly, replacing official's
+ * `attachSettledTurns(coalesceSettledTurns(out, meta), meta)`:
+ * - never merge separate runs into one Worked row (no coalescing);
+ * - place classic activity below its run's last reply (owner choice);
+ * - attach only Paperclip Runner turns to their reply (official renders those
+ *   above the answer and keeps the footer); classic turns stay standalone rows
+ *   so they never take over the reply's timestamp/actions footer;
+ * - mark consecutive separate runs of the same agent as follow-ups.
+ */
+export function arrangeRunActivity(
+  items: readonly TaskChatItem[],
+  {
+    settledTurns,
+    metaById,
+    comments,
+  }: {
+    settledTurns: readonly {
+      turn: TaskChatTurnItem;
+      anchorCommentId: string | null;
+    }[];
+    metaById: ReadonlyMap<string, SettledTurnMergeMeta>;
+    comments: readonly RunReplyComment[];
+  },
+): TaskChatItem[] {
+  const replyIdByTurnId = new Map<string, string>();
+  for (const { turn, anchorCommentId } of settledTurns) {
+    if (anchorCommentId && !turn.standaloneHeader)
+      replyIdByTurnId.set(turn.id, anchorCommentId);
+  }
+  const runIdByCommentId = new Map<string, string>();
+  for (const comment of comments) {
+    const runId = commentRunId(comment);
+    if (comment.id && runId) runIdByCommentId.set(comment.id, runId);
+  }
+  const lifted = placeTurnsBelowReplies(items, replyIdByTurnId, runIdByCommentId);
+
+  const runnerMeta = new Map<string, SettledTurnMergeMeta>();
+  for (const item of lifted) {
+    if (item.kind !== "turn" || !item.standaloneHeader) continue;
+    const meta = metaById.get(item.id);
+    if (meta) runnerMeta.set(item.id, meta);
+  }
+  const attached = attachSettledTurns(lifted, runnerMeta);
+
+  return markFollowUpRuns(attached, metaById, runIdByCommentId);
+}
