+          dropTickets(agentId);
+          await bestEffort(() => supervisor.setControl(agentId, false));
+          await bestEffort(() => supervisor.stop(agentId));
+          await transition(companyId, agentId, "stop", { kind: "system" }, { details: { reason: "agent_disabled" } });
+        }
+        return readComputerUse((await loadAgent(companyId, agentId)).metadata);
+      });
+    },
+
+    /** Operator control actions. Every one waits for any in-flight agent action first. */
+    async operate(companyId: string, agentId: string, action: OperatorAction, actor: ComputerUseActor & { kind: "operator" }) {
+      // Join the agent's queue first, so an operator's click is ordered before any later agent call.
+      return locks.run(agentId, async () => {
+        if (!(await isComputerUseEnabled(db, companyId))) throw conflict("Turn on computer use in Company Settings first.");
+        const event = OPERATOR_EVENT[action];
+        switch (event) {
+          case "start":
+            await startLocked(companyId, agentId, actor);
+            break;
+          case "take_control":
+          case "take_control_private": {
+            const grantedAt = now();
+            const lease = { holderUserId: actor.userId, private: event === "take_control_private", grantedAt: grantedAt.toISOString(), expiresAt: new Date(grantedAt.getTime() + leaseMs).toISOString() };
+            const { before } = await transition(companyId, agentId, event, actor, { lease });
+            dropTickets(agentId, "control");
+            if (before.state === "paused") await supervisor.thaw(agentId);
+            // The agent is already refused (state changed above); now open the interactive stream.
+            await supervisor.setControl(agentId, true);
+            break;
+          }
+          case "release":
+            dropTickets(agentId, "control");
+            await bestEffort(() => supervisor.setControl(agentId, false));
+            await transition(companyId, agentId, "release", actor);
+            break;
+          case "pause":
+            dropTickets(agentId, "control");
+            await transition(companyId, agentId, "pause", actor);
+            await bestEffort(() => supervisor.setControl(agentId, false));
+            await supervisor.freeze(agentId);
+            break;
+          case "resume":
+            await supervisor.thaw(agentId);
+            await transition(companyId, agentId, "resume", actor);
+            break;
+          case "stop":
+            dropTickets(agentId);
+            await transition(companyId, agentId, "stop", actor);
+            await bestEffort(() => supervisor.setControl(agentId, false));
+            await bestEffort(() => supervisor.stop(agentId));
+            break;
+          case "revoke":
+            dropTickets(agentId);
+            await transition(companyId, agentId, "revoke", actor);
+            await bestEffort(() => supervisor.setControl(agentId, false));
+            await bestEffort(() => supervisor.stop(agentId));
+            break;
+          case "restore":
+            await transition(companyId, agentId, "restore", actor);
+            break;
+          default:
+            throw conflict("Unknown action");
+        }
+        return readComputerUse((await loadAgent(companyId, agentId)).metadata);
+      });
+    },
+
+    async deleteComputer(companyId: string, agentId: string, purgeProfile: boolean, actor: ComputerUseActor & { kind: "operator" }) {
+      return locks.run(agentId, async () => {
+        const meta = readComputerUse((await loadAgent(companyId, agentId)).metadata);
+        if (isLive(meta.state)) throw conflict("Stop the computer first.");
+        dropTickets(agentId);
+        await supervisor.destroy(agentId, purgeProfile);
+        await logActivity(db, {
+          companyId, ...activityActor(actor), action: "ppclip.computer_use.deleted",
+          entityType: "agent", entityId: agentId, details: { purgeProfile },
+        });
+        return { ok: true };
+      });
+    },
+
+    /** Agent-side start, used when a tool is called and the computer is not running. Caller holds the lock. */
+    startForAgentLocked: (companyId: string, agentId: string, runId: string | null) =>
+      startLocked(companyId, agentId, { kind: "agent", agentId, runId }),
+
+    /** Agent asks for a person. Caller holds the lock. */
+    requestTakeoverLocked: (companyId: string, agentId: string, runId: string | null, reason: string) =>
+      transition(companyId, agentId, "request_takeover", { kind: "agent", agentId, runId }, {
+        request: { reason: reason.slice(0, 300), at: now().toISOString(), runId },
+        details: { reason: reason.slice(0, 300) },
+      }),
+
+    /** Records that the agent used its computer (throttled to one write a minute). */
+    async touch(companyId: string, agentId: string) {
+      const agent = await loadAgent(companyId, agentId);
+      const meta = readComputerUse(agent.metadata);
+      if (meta.lastActivityAt && now().getTime() - Date.parse(meta.lastActivityAt) < 60_000) return;
+      await db.update(agents)
+        .set({ metadata: sql`jsonb_set(coalesce(${agents.metadata}, '{}'::jsonb), '{computerUse,lastActivityAt}', to_jsonb(${now().toISOString()}::text), true)` })
+        .where(and(eq(agents.id, agentId), sql`${agents.metadata} ? 'computerUse'`));
+    },
+
+    async logTool(companyId: string, agentId: string, runId: string | null, details: Record<string, unknown>) {
+      await logActivity(db, {
+        companyId, ...activityActor({ kind: "agent", agentId, runId }),
+        action: "ppclip.computer_use.tool", entityType: "agent", entityId: agentId, details,
+      });
+    },
+
+    readMeta: async (companyId: string, agentId: string) => readComputerUse((await loadAgent(companyId, agentId)).metadata),
+
+    /** A short-lived capability for the live view. View tickets work while the computer is live; control tickets need the caller's lease. */
+    async issueTicket(companyId: string, agentId: string, userId: string, mode: "view" | "control") {
+      if (!(await isComputerUseEnabled(db, companyId))) throw conflict("Computer use is off.");
+      const meta = readComputerUse((await loadAgent(companyId, agentId)).metadata);
+      if (!meta.enabled || !isLive(meta.state)) throw conflict("The computer is not running.");
+      if (mode === "control" && (!meta.lease || meta.lease.holderUserId !== userId)) throw forbidden("Take control first.");
+      for (const [key, ticket] of tickets) if (ticket.expiresAt < Date.now()) tickets.delete(key);
+      const ticket = randomBytes(24).toString("base64url");
+      tickets.set(ticket, { companyId, agentId, userId, mode, leaseGrantedAt: mode === "control" ? meta.lease!.grantedAt : null, expiresAt: Date.now() + ticketTtlMs });
+      return ticket;
+    },
+
+    /** Re-checks a ticket against current state. Used on every stream request and every second while streaming. */
+    async resolveTicket(ticket: string): Promise<ViewerTicket | null> {
+      const entry = tickets.get(ticket);
+      if (!entry) return null;
+      if (entry.expiresAt < Date.now()) {
+        tickets.delete(ticket);
+        return null;
+      }
+      const [row] = await db.select({ metadata: agents.metadata, status: agents.status }).from(agents)
+        .where(and(eq(agents.id, entry.agentId), eq(agents.companyId, entry.companyId)));
+      if (!row || row.status === "terminated") return null;
+      const meta = readComputerUse(row.metadata);
+      const valid = meta.enabled && isLive(meta.state) && (entry.mode === "view"
+        || ((meta.state === "human" || meta.state === "human_private") && meta.lease?.holderUserId === entry.userId
+          && meta.lease.grantedAt === entry.leaseGrantedAt && Date.parse(meta.lease.expiresAt) > now().getTime()));
+      if (!valid) {
+        tickets.delete(ticket);
+        return null;
+      }
+      return entry;
+    },
+
+    /** Lease expiry (person → paused) and idle stop (agent idle → stopped). Run every 30 s. */
+    async sweep() {
+      const rows = await db.select().from(agents)
+        .where(sql`${agents.metadata}->'computerUse'->>'state' in ('human','human_private','agent','starting')`);
+      const t = now().getTime();
+      for (const agent of rows) {
+        const meta = readComputerUse(agent.metadata);
+        const companyId = agent.companyId;
+        try {
+          if ((meta.state === "human" || meta.state === "human_private") && meta.lease && Date.parse(meta.lease.expiresAt) <= t) {
+            await locks.run(agent.id, async () => {
+              dropTickets(agent.id, "control");
+              await bestEffort(() => supervisor.setControl(agent.id, false));
+              await transition(companyId, agent.id, "lease_expired", { kind: "system" });
+              await bestEffort(() => supervisor.freeze(agent.id));
+            });
+          } else if (meta.state === "agent" && t - Date.parse(meta.lastActivityAt ?? meta.updatedAt ?? new Date(0).toISOString()) > idleMs) {
+            await locks.run(agent.id, async () => {
+              dropTickets(agent.id);
+              await transition(companyId, agent.id, "stop", { kind: "system" }, { details: { reason: "idle" } });
+              await bestEffort(() => supervisor.stop(agent.id));
+            });
+          } else if (meta.state === "starting" && t - Date.parse(meta.updatedAt ?? new Date(0).toISOString()) > 5 * 60_000) {
+            await locks.run(agent.id, () => transition(companyId, agent.id, "fail", { kind: "system" }, { details: { reason: "start_timeout" } }));
+          }
+        } catch {
+          // A concurrent change won; the next sweep re-evaluates.
+        }
+      }
+    },
+  };
+}
+
+export type ComputerUseService = ReturnType<typeof computerUseService>;
+
+const instances = new WeakMap<Db, ComputerUseService>();
+
+/** One service per database handle, shared by routes, the MCP endpoint and the stream proxy. */
+export function sharedComputerUseService(db: Db, factory: () => ComputerUseService) {
+  let service = instances.get(db);
+  if (!service) {
+    service = factory();
+    instances.set(db, service);
+  }
+  return service;
+}
diff --git a/server/src/ppclip/computer-use/state.ts b/server/src/ppclip/computer-use/state.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84e882d175141550e8008f3ba8f794ca48f25c33
--- /dev/null
+++ b/server/src/ppclip/computer-use/state.ts
@@ -0,0 +1,264 @@
+/**
+ * ppclip computer use: the per-agent control state machine (pure, no I/O).
+ *
+ * State lives in the agent's existing metadata JSON (`metadata.computerUse`),
+ * so there is no migration. Only the board computer-use endpoints and the
+ * computer-use service write it; ordinary agent PATCHes and hires cannot (see
+ * preserveComputerUseMetadata / stripComputerUseMetadata).
+ *
+ *   off/stopped ──start──► starting ──ready──► agent
+ *   agent ──request_takeover (agent)──► waiting_for_human
+ *   agent | waiting_for_human | paused ──take_control (operator)──► human | human_private
+ *   human | human_private ──release (operator only)──► agent
+ *   agent | waiting_for_human | human | human_private ──pause──► paused ──resume──► agent
+ *   human | human_private ──lease_expired (system)──► paused
+ *   any (not revoked) ──stop──► stopped;  any ──revoke──► revoked ──restore──► stopped
+ *
+ * Every transition bumps `epoch`. Observations carry the epoch they were taken
+ * in, and an agent action that cites an older epoch is refused, so the agent
+ * must look again after any change of control.
+ */
+
+export const COMPUTER_USE_METADATA_KEY = "computerUse";
+
+export const COMPUTER_STATES = [
+  "off",
+  "starting",
+  "agent",
+  "waiting_for_human",
+  "human",
+  "human_private",
+  "paused",
+  "stopped",
+  "revoked",
+] as const;
+export type ComputerState = (typeof COMPUTER_STATES)[number];
+
+export type ComputerEvent =
+  | "start"
+  | "ready"
+  | "fail"
+  | "request_takeover"
+  | "take_control"
+  | "take_control_private"
+  | "release"
+  | "pause"
+  | "resume"
+  | "lease_expired"
+  | "stop"
+  | "revoke"
+  | "restore";
+
+export type ComputerActorKind = "operator" | "agent" | "system";
+
+export type ControlLease = {
+  holderUserId: string;
+  private: boolean;
+  grantedAt: string;
+  expiresAt: string;
+};
+
+export type TakeoverRequest = { reason: string; at: string; runId?: string | null };
+
+export type ComputerUseMeta = {
+  /** Per-agent opt-in. Off unless an operator turns it on. */
+  enabled: boolean;
+  state: ComputerState;
+  epoch: number;
+  lease: ControlLease | null;
+  request: TakeoverRequest | null;
+  /** Shell inside the sandbox. Off by default. Never runs on the host. */
+  shell: boolean;
+  /** Optional hostname allowlist for the sandbox browser (empty = any public site). */
+  allowedHosts: string[];
+  lastActivityAt: string | null;
+  updatedAt: string | null;
+  updatedBy: string | null;
+};
+
+type Rule = { from: readonly ComputerState[] | "any_but_revoked" | "any"; to: ComputerState; by: readonly ComputerActorKind[] };
+
+/** Who may trigger what. This table is the contract shown in the README. */
+export const TRANSITIONS: Record<ComputerEvent, Rule> = {
+  start: { from: ["off", "stopped"], to: "starting", by: ["operator", "agent", "system"] },
+  ready: { from: ["starting"], to: "agent", by: ["system"] },
+  fail: { from: ["starting"], to: "stopped", by: ["system"] },
+  request_takeover: { from: ["agent"], to: "waiting_for_human", by: ["agent"] },
+  take_control: { from: ["agent", "waiting_for_human", "paused"], to: "human", by: ["operator"] },
+  take_control_private: { from: ["agent", "waiting_for_human", "paused", "human"], to: "human_private", by: ["operator"] },
+  release: { from: ["human", "human_private"], to: "agent", by: ["operator"] },
+  pause: { from: ["agent", "waiting_for_human", "human", "human_private"], to: "paused", by: ["operator"] },
+  resume: { from: ["paused"], to: "agent", by: ["operator"] },
+  lease_expired: { from: ["human", "human_private"], to: "paused", by: ["system"] },
+  stop: { from: "any_but_revoked", to: "stopped", by: ["operator", "system"] },
+  revoke: { from: "any", to: "revoked", by: ["operator"] },
+  restore: { from: ["revoked"], to: "stopped", by: ["operator"] },
+};
+
+export class ComputerTransitionError extends Error {
+  constructor(readonly code: "not_allowed" | "invalid_state", message: string) {
+    super(message);
+  }
+}
+
+export function canTransition(state: ComputerState, event: ComputerEvent, by: ComputerActorKind) {
+  const rule = TRANSITIONS[event];
+  if (!rule.by.includes(by)) return false;
+  if (rule.from === "any") return true;
+  if (rule.from === "any_but_revoked") return state !== "revoked";
+  return rule.from.includes(state);
+}
+
+/** Applies one event. Throws ComputerTransitionError when the actor or state does not allow it. */
+export function applyTransition(
+  meta: ComputerUseMeta,
+  event: ComputerEvent,
+  by: ComputerActorKind,
+  extra: { now: Date; actorId: string; lease?: ControlLease | null; request?: TakeoverRequest | null },
+): ComputerUseMeta {
+  const rule = TRANSITIONS[event];
+  if (!rule.by.includes(by)) {
+    throw new ComputerTransitionError("not_allowed", `${by === "agent" ? "An agent" : by === "system" ? "The system" : "An operator"} cannot ${eventWords(event)}.`);
+  }
+  if (!canTransition(meta.state, event, by)) {
+    throw new ComputerTransitionError("invalid_state", `Cannot ${eventWords(event)} while the computer is ${stateWords(meta.state)}.`);
+  }
+  const to = rule.to;
+  const holdsControl = to === "human" || to === "human_private";
+  return {
+    ...meta,
+    state: to,
+    epoch: meta.epoch + 1,
+    lease: holdsControl ? (extra.lease ?? meta.lease) : null,
+    request: to === "waiting_for_human" ? (extra.request ?? meta.request) : holdsControl ? meta.request : null,
+    updatedAt: extra.now.toISOString(),
+    updatedBy: extra.actorId,
+  };
+}
+
+/** The agent may act (click, type, navigate, shell) only in `agent`. */
+export function agentMayAct(state: ComputerState) {
+  return state === "agent";
+}
+
+/** The agent may look at the screen unless the human asked for privacy, or it is paused or not running. */
+export function agentMayObserve(state: ComputerState) {
+  return state === "agent" || state === "waiting_for_human" || state === "human";
+}
+
+/** States in which a sandbox should be running. */
+export function isLive(state: ComputerState) {
+  return state !== "off" && state !== "stopped" && state !== "revoked";
+}
+
+export function stateWords(state: ComputerState) {
+  switch (state) {
+    case "off": return "off";
+    case "starting": return "starting";
+    case "agent": return "driven by the agent";
+    case "waiting_for_human": return "waiting for a person";
+    case "human": return "controlled by a person";
+    case "human_private": return "controlled by a person in private mode";
+    case "paused": return "paused";
+    case "stopped": return "stopped";
+    case "revoked": return "revoked";
+  }
+}
+
+function eventWords(event: ComputerEvent) {
+  switch (event) {
+    case "start": return "start the computer";
+    case "ready": return "mark the computer ready";
+    case "fail": return "mark the computer failed";
+    case "request_takeover": return "ask for a person";
+    case "take_control": return "take control";
+    case "take_control_private": return "take control privately";
+    case "release": return "release control";
+    case "pause": return "pause";
+    case "resume": return "resume";
+    case "lease_expired": return "expire control";
+    case "stop": return "stop the computer";
+    case "revoke": return "revoke access";
+    case "restore": return "restore access";
+  }
+}
+
+type JsonRecord = Record<string, unknown>;
+function asRecord(value: unknown): JsonRecord {
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as JsonRecord) : {};
+}
+
+export function defaultComputerUse(): ComputerUseMeta {
+  return {
+    enabled: false,
+    state: "off",
+    epoch: 0,
+    lease: null,
+    request: null,
+    shell: false,
+    allowedHosts: [],
+    lastActivityAt: null,
+    updatedAt: null,
+    updatedBy: null,
+  };
+}
+
+/** Reads `metadata.computerUse`, tolerating missing or malformed values. */
+export function readComputerUse(metadata: unknown): ComputerUseMeta {
+  const raw = asRecord(asRecord(metadata)[COMPUTER_USE_METADATA_KEY]);
+  const base = defaultComputerUse();
+  const state = COMPUTER_STATES.includes(raw.state as ComputerState) ? (raw.state as ComputerState) : base.state;
+  const lease = asRecord(raw.lease);
+  const request = asRecord(raw.request);
+  return {
+    enabled: raw.enabled === true,
+    state,
+    epoch: typeof raw.epoch === "number" && Number.isFinite(raw.epoch) ? Math.max(0, Math.floor(raw.epoch)) : 0,
+    lease: typeof lease.holderUserId === "string" && typeof lease.expiresAt === "string"
+      ? { holderUserId: lease.holderUserId, private: lease.private === true, grantedAt: String(lease.grantedAt ?? ""), expiresAt: lease.expiresAt }
+      : null,
+    request: typeof request.reason === "string" && typeof request.at === "string"
+      ? { reason: request.reason, at: request.at, runId: typeof request.runId === "string" ? request.runId : null }
+      : null,
+    shell: raw.shell === true,
+    allowedHosts: Array.isArray(raw.allowedHosts) ? raw.allowedHosts.filter((h): h is string => typeof h === "string").slice(0, 50) : [],
+    lastActivityAt: typeof raw.lastActivityAt === "string" ? raw.lastActivityAt : null,
+    updatedAt: typeof raw.updatedAt === "string" ? raw.updatedAt : null,
+    updatedBy: typeof raw.updatedBy === "string" ? raw.updatedBy : null,
+  };
+}
+
+export function withComputerUse(metadata: unknown, meta: ComputerUseMeta): JsonRecord {
+  return { ...asRecord(metadata), [COMPUTER_USE_METADATA_KEY]: meta };
+}
+
+/** Agent PATCHes keep the stored computer-use record; callers cannot set or clear it. */
+export function preserveComputerUseMetadata(existing: unknown, next: unknown): JsonRecord | null {
+  const stored = asRecord(existing);
+  const has = Object.prototype.hasOwnProperty.call(stored, COMPUTER_USE_METADATA_KEY);
+  if (next === null && !has) return null;
+  const result = { ...asRecord(next) };
+  delete result[COMPUTER_USE_METADATA_KEY];
+  if (has) result[COMPUTER_USE_METADATA_KEY] = stored[COMPUTER_USE_METADATA_KEY];
+  return result;
+}
+
+/** New agents (hires, duplicates) never inherit a computer or its access. */
+export function stripComputerUseMetadata<T>(metadata: T): T {
+  if (!metadata || typeof metadata !== "object" || Array.isArray(metadata)) return metadata;
+  const record = metadata as JsonRecord;
+  if (!Object.prototype.hasOwnProperty.call(record, COMPUTER_USE_METADATA_KEY)) return metadata;
+  const result = { ...record };
+  delete result[COMPUTER_USE_METADATA_KEY];
+  return result as T;
+}
+
+/** Normalises an operator-supplied host allowlist: lowercase hostnames, optional leading "*.". */
+export function normalizeAllowedHosts(input: readonly string[]): string[] {
+  const out = new Set<string>();
+  for (const raw of input) {
+    const value = raw.trim().toLowerCase().replace(/^https?:\/\//, "").replace(/\/.*$/, "");
+    if (/^(\*\.)?[a-z0-9-]+(\.[a-z0-9-]+)+$/.test(value)) out.add(value);
+  }
+  return [...out].slice(0, 50);
+}
diff --git a/server/src/ppclip/computer-use/stream-proxy.ts b/server/src/ppclip/computer-use/stream-proxy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e4364fac07571c071b8f31c261aca931ff6fc81
--- /dev/null
+++ b/server/src/ppclip/computer-use/stream-proxy.ts
@@ -0,0 +1,52 @@
+import type { IncomingMessage, Server } from "node:http";
+import type { Duplex } from "node:stream";
+import { WebSocket, WebSocketServer } from "ws";
+import type { Db } from "@paperclipai/db";
+import { ppclipComputerUse } from "./index.js";
+import type { ComputerUseService } from "./service.js";
+import { pipeSockets } from "./supervisor/server.js";
+import { ppclipFeature } from "../features.js";
+
+const PATH = /^\/api\/ppclip\/computer-use\/view\/([A-Za-z0-9_-]{16,64})\/websockify$/;
+const RECHECK_MS = 1000;
+
+/**
+ * WebSocket proxy for the live view: browser ⇄ Paperclip ⇄ supervisor ⇄ sandbox.
+ * The ticket is checked on connect and again every second; the connection is
+ * dropped as soon as control changes, access is revoked or the ticket expires.
+ * Registered before official handlers, and marks requests it owns as handled.
+ */
+export function setupPpclipComputerStreamProxy(server: Server, db: Db, service: ComputerUseService = ppclipComputerUse(db)) {
+  const wss = new WebSocketServer({ noServer: true, maxPayload: 8 * 1024 * 1024 });
+  server.on("upgrade", (req: IncomingMessage & { paperclipWebSocketHandled?: boolean }, socket: Duplex, head: Buffer) => {
+    const url = new URL(req.url ?? "/", "http://localhost");
+    const match = PATH.exec(url.pathname);
+    if (!match) return;
+    req.paperclipWebSocketHandled = true;
+    const reject = (status: string) => socket.end(`HTTP/1.1 ${status}\r\nConnection: close\r\n\r\n`);
+    if (!ppclipFeature("computerUse")) return reject("404 Not Found");
+    const ticketId = match[1]!;
+    void service.resolveTicket(ticketId).then((ticket) => {
+      if (!ticket) return reject("403 Forbidden");
+      const target = service.supervisor.streamSocket(ticket.agentId, ticket.mode);
+      if (!target) return reject("503 Service Unavailable");
+      const upstream = new WebSocket(target.url, ["binary"], { headers: target.headers });
+      upstream.once("error", () => reject("502 Bad Gateway"));
+      upstream.once("open", () => {
+        wss.handleUpgrade(req, socket, head, (client) => {
+          pipeSockets(client, upstream);
+          const timer = setInterval(() => {
+            void service.resolveTicket(ticketId).then((still) => {
+              if (!still) {
+                client.close(4001, "Control changed");
+                upstream.terminate();
+              }
+            }).catch(() => client.terminate());
+          }, RECHECK_MS);
+          client.on("close", () => clearInterval(timer));
+        });
+      });
+    }).catch(() => reject("500 Internal Server Error"));
+  });
+  return wss;
+}
diff --git a/server/src/ppclip/computer-use/supervisor-client.ts b/server/src/ppclip/computer-use/supervisor-client.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3b3908583098bae7048ad56cabe2523f698c7e00
--- /dev/null
+++ b/server/src/ppclip/computer-use/supervisor-client.ts
@@ -0,0 +1,94 @@
+import type { ActOptions, ActResult, ComputerAction, ComputerInfo, Observation, PageAction, PageSnapshot, ProviderInfo } from "./supervisor/provider.js";
+import { defaultSupervisorUrl, readToken } from "./supervisor/config.js";
+
+export class SupervisorError extends Error {
+  constructor(readonly code: string, message: string, readonly status: number) {
+    super(message);
+  }
+}
+
+export type SupervisorHealth = { ok: true; provider: ProviderInfo } | { ok: false; error: string };
+
+/** What Paperclip needs from the computer supervisor. */
+export interface SupervisorClient {
+  health(): Promise<SupervisorHealth>;
+  ensure(agentId: string, spec: { companyId: string; shell: boolean; allowedHosts: string[] }): Promise<ComputerInfo>;
+  inspect(agentId: string): Promise<ComputerInfo | null>;
+  stop(agentId: string): Promise<void>;
+  destroy(agentId: string, purgeProfile: boolean): Promise<void>;
+  freeze(agentId: string): Promise<void>;
+  thaw(agentId: string): Promise<void>;
+  observe(agentId: string): Promise<Observation>;
+  act(agentId: string, actions: ComputerAction[], opts: ActOptions): Promise<ActResult>;
+  page(agentId: string, opts: { marks: boolean }): Promise<PageSnapshot>;
+  pageAct(agentId: string, action: PageAction, opts: ActOptions): Promise<ActResult>;
+  setControl(agentId: string, interactive: boolean): Promise<void>;
+  shell(agentId: string, command: string, timeoutMs: number): Promise<{ exitCode: number; output: string }>;
+  /** GET a noVNC file through the supervisor. */
+  streamFile(agentId: string, mode: "view" | "control", file: string, search: string): Promise<Response>;
+  /** Where to open the websockify WebSocket, with the auth header to send. */
+  streamSocket(agentId: string, mode: "view" | "control"): { url: string; headers: Record<string, string> } | null;
+}
+
+/** HTTP client. The token is read from the supervisor's token file on each call (it may appear after Paperclip starts). */
+export function httpSupervisorClient(opts: { url?: string; token?: () => string | null } = {}): SupervisorClient {
+  const base = (opts.url ?? defaultSupervisorUrl()).replace(/\/+$/, "");
+  const token = opts.token ?? (() => process.env.PPCLIP_COMPUTER_SUPERVISOR_TOKEN ?? readToken());
+
+  function auth() {
+    const value = token();
+    if (!value) throw new SupervisorError("unavailable", "The computer supervisor is not set up yet. Start it with: node scripts/ppclip/computer-supervisor.mjs", 503);
+    return { authorization: `Bearer ${value}` };
+  }
+
+  async function call<T>(method: string, path: string, body?: unknown, timeoutMs = 60_000): Promise<T> {
+    let res: Response;
+    try {
+      res = await fetch(`${base}${path}`, {
+        method,
+        headers: { ...auth(), ...(body === undefined ? {} : { "content-type": "application/json" }) },
+        body: body === undefined ? undefined : JSON.stringify(body),
+        signal: AbortSignal.timeout(timeoutMs),
+      });
+    } catch (err) {
+      if (err instanceof SupervisorError) throw err;
+      throw new SupervisorError("unavailable", `The computer supervisor is not reachable at ${base}. Is it running?`, 503);
+    }
+    const json = (await res.json().catch(() => ({}))) as T & { error?: string; code?: string };
+    if (!res.ok) throw new SupervisorError(json.code ?? "error", json.error ?? `supervisor error ${res.status}`, res.status);
+    return json;
+  }
+
+  const path = (agentId: string, rest = "") => `/computers/${encodeURIComponent(agentId)}${rest}`;
+
+  return {
+    async health() {
+      try {
+        const res = await call<{ ok: true; provider: ProviderInfo }>("GET", "/health", undefined, 3000);
+        return { ok: true, provider: res.provider };
+      } catch (err) {
+        return { ok: false, error: err instanceof Error ? err.message : "unreachable" };
+      }
+    },
+    ensure: (agentId, spec) => call("POST", path(agentId, "/ensure"), spec, 120_000),
+    inspect: async (agentId) => (await call<{ computer: ComputerInfo | null }>("GET", path(agentId))).computer,
+    stop: async (agentId) => { await call("POST", path(agentId, "/stop")); },
+    destroy: async (agentId, purgeProfile) => { await call("DELETE", path(agentId, purgeProfile ? "?purgeProfile=1" : "")); },
+    freeze: async (agentId) => { await call("POST", path(agentId, "/freeze")); },
+    thaw: async (agentId) => { await call("POST", path(agentId, "/thaw")); },
+    observe: (agentId) => call("POST", path(agentId, "/observe")),
+    act: (agentId, actions, o) => call("POST", path(agentId, "/act"), { actions, ...o }),
+    page: (agentId, o) => call("POST", path(agentId, "/page"), o),
+    pageAct: (agentId, action, o) => call("POST", path(agentId, "/page/act"), { action, ...o }),
+    setControl: async (agentId, interactive) => { await call("POST", path(agentId, "/control"), { interactive }); },
+    shell: (agentId, command, timeoutMs) => call("POST", path(agentId, "/shell"), { command, timeoutMs }, timeoutMs + 10_000),
+    async streamFile(agentId, mode, file, search) {
+      return fetch(`${base}${path(agentId, `/stream/${mode}/${file}`)}${search}`, { headers: auth(), signal: AbortSignal.timeout(15_000) });
+    },
+    streamSocket(agentId, mode) {
+      const value = token();
+      if (!value) return null;
+      return { url: `${base.replace(/^http/, "ws")}${path(agentId, `/stream/${mode}/websockify`)}`, headers: { authorization: `Bearer ${value}` } };
+    },
+  };
+}
diff --git a/server/src/ppclip/computer-use/supervisor/config.ts b/server/src/ppclip/computer-use/supervisor/config.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e586f7082276520a175ab45d59c6f6ed1ce2a7d6
--- /dev/null
+++ b/server/src/ppclip/computer-use/supervisor/config.ts
@@ -0,0 +1,31 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { randomBytes } from "node:crypto";
+
+/** Shared between the supervisor and Paperclip: where the bearer token lives. */
+export function defaultTokenFile() {
+  return process.env.PPCLIP_COMPUTER_SUPERVISOR_TOKEN_FILE ?? path.join(os.homedir(), ".paperclip", "ppclip-computer-supervisor.token");
+}
+
+export function defaultSupervisorUrl() {
+  return process.env.PPCLIP_COMPUTER_SUPERVISOR_URL ?? "http://127.0.0.1:7091";
+}
+
+/** Reads the token, creating it (mode 0600) on first start. */
+export function ensureToken(file: string) {
+  if (fs.existsSync(file)) return fs.readFileSync(file, "utf8").trim();
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  const token = randomBytes(32).toString("hex");
+  fs.writeFileSync(file, `${token}\n`, { mode: 0o600 });
+  return token;
+}
+
+/** Reads the token if the supervisor has created it; never creates one. */
+export function readToken(file = defaultTokenFile()) {
+  try {
+    return fs.readFileSync(file, "utf8").trim() || null;
+  } catch {
+    return null;
+  }
+}
