+import { EXTRA_COLUMNS_STORAGE_KEY } from "./RosterExtraColumns";
+import { AgentTaskHoverCard, orderCurrentTasks } from "./AgentTaskHoverCard";
+
+const api = vi.hoisted(() => ({
+  agents: vi.fn(),
+  issues: vi.fn(),
+  navigate: vi.fn(),
