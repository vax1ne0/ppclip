+/**
+ * ppclip PROV-2: provider-routing policy storage and the in-server controller.
+ *
+ * Storage needs no migration and has one source of truth, the database:
+ * - The company policy is the latest `ppclip.provider_routing.updated` activity
+ *   row for the company (its `details.policy`). Every save is an audit entry.
+ * - While an agent runs away from its own provider, `agents.metadata.ppclipProviderRouting`
+ *   keeps its own config (without env) so Hybrid can restore it.
+ * - Controller health lives in this server process: the controller runs here.
+ *
+ * Usage observations come only from official Connections usage
+ * (`aiConnectionService.probeUsage`), probed as the board user who turned
+ * routing on, with a short cache so providers are not polled aggressively.
+ */
+import { and, desc, eq, inArray, isNotNull, notInArray, sql } from "drizzle-orm";
+import { activityLog, agents, heartbeatRuns, issues, type Db } from "@paperclipai/db";
+import {
+  aiConnectionBindingSchema,
+  type AiConnectionUsage,
+  type AiManagedConnectionSummary,
+} from "@paperclipai/shared";
+import { claudeLocalReasoningEffortsForModel } from "@paperclipai/adapter-claude-local";
+import { codexLocalReasoningEffortsForModel } from "@paperclipai/adapter-codex-local";
+import { grokLocalReasoningEffortsForModel } from "@paperclipai/adapter-grok-local";
+import { conflict, notFound, unprocessable } from "../../errors.js";
+import { sanitizeRecord } from "../../redaction.js";
+import { logActivity } from "../../services/activity-log.js";
+import { updateAgentConfigurationInTransaction } from "../../services/agent-configuration-transaction.js";
+import { aiConnectionService } from "../../services/ai-connections.js";
+import { ppclipFeature } from "../features.js";
+import {
+  aiProviderForAdapter,
+  buildRoutedConfig,
+  configSignature,
+  decideTarget,
+  defaultPolicy,
+  isRoutableAdapter,
+  mapModel,
+  providerQuotaState,
+  readRoutingRecord,
+  restoredConfig,
+  routingPolicyInputSchema,
+  withRoutingRecord,
+  withTierMemberships,
+  type HarnessConfig,
+  type QuotaState,
+  type RoutingPolicy,
+  type RoutingPolicyInput,
+} from "./policy.js";
+
+export const POLICY_UPDATED_ACTION = "ppclip.provider_routing.updated";
+export const AGENT_SWITCHED_ACTION = "ppclip.provider_routing.agent_switched";
+export const AGENT_RELEASED_ACTION = "ppclip.provider_routing.agent_released";
+export const CONTROLLER_INTERVAL_MS = 60_000;
+const USAGE_TTL_MS = 5 * 60_000;
+const LIVE_RUN_STATUSES = ["queued", "running", "scheduled_retry"];
+const CLOSED_TASK_STATUSES = ["done", "cancelled"];
+const WAITING_AGENT_STATUSES = new Set(["running", "paused", "pending_approval"]);
+
+type AgentRow = typeof agents.$inferSelect;
+type JsonRecord = Record<string, unknown>;
+export type RoutingActor = { actorType: "user" | "system"; actorId: string };
+export type AgentRoutingHealth = {
+  agentId: string;
+  state: "ready" | "switched" | "waiting" | "blocked";
+  message: string;
+  adapterType: string;
+  primaryAdapterType: string | null;
+};
+export type ProviderQuota = { adapterType: string; state: QuotaState; accounts: number };
+export type ControllerHealth = {
+  checkedAt: string;
+  revision: number;
+  agents: AgentRoutingHealth[];
+  quotas: ProviderQuota[];
+  error: string | null;
+};
+export type ProviderCandidate = {
+  adapterType: string;
+  agents: { id: string; name: string }[];
+};
+export type ProviderRoutingStatus = {
+  policy: RoutingPolicy;
+  candidates: ProviderCandidate[];
+  routedAgents: { agentId: string; name: string; adapterType: string; primaryAdapterType: string }[];
+  controller: { intervalMs: number; health: ControllerHealth | null };
+};
+
+/** Seams for tests: Connections listing and usage probes default to official's service. */
+export type UsageSource = {
+  listAccounts: (companyId: string, userId: string) => Promise<AiManagedConnectionSummary[]>;
+  probe: (companyId: string, userId: string, account: AiManagedConnectionSummary) => Promise<AiConnectionUsage | null>;
+};
+
+function asRecord(value: unknown): JsonRecord {
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as JsonRecord) : {};
+}
+
+export function harnessOf(agent: Pick<AgentRow, "adapterType" | "adapterConfig" | "runtimeConfig">): HarnessConfig {
+  return {
+    adapterType: agent.adapterType,
+    adapterConfig: asRecord(agent.adapterConfig),
+    aiConnection: asRecord(agent.runtimeConfig).aiConnection ?? null,
+  };
+}
+
+/** The agent's own provider config: its saved one while routed, else its current one. */
+function ownHarness(agent: AgentRow): HarnessConfig {
+  return readRoutingRecord(agent.metadata)?.primary ?? harnessOf(agent);
+}
+
+function withoutEnv(config: HarnessConfig): HarnessConfig {
+  const { env: _env, ...adapterConfig } = config.adapterConfig;
+  return { ...config, adapterConfig };
+}
+
+export function supportedEfforts(adapterType: string, model: string): readonly string[] {
+  if (adapterType === "claude_local") return claudeLocalReasoningEffortsForModel(model);
+  if (adapterType === "codex_local") return codexLocalReasoningEffortsForModel(model);
+  if (adapterType === "grok_local") return grokLocalReasoningEffortsForModel(model);
+  return [];
+}
+
+const usageCache = new Map<string, { expires: number; value: AiConnectionUsage }>();
+export function clearProviderUsageCache() {
+  usageCache.clear();
+}
+
+export function officialUsageSource(db: Db): UsageSource {
+  const connections = aiConnectionService(db);
+  return {
+    listAccounts: (companyId, userId) => connections.list(companyId, userId),
+    probe: async (companyId, userId, account) => {
+      const key = `${companyId}:${account.id}:${account.grantId}`;
+      const cached = usageCache.get(key);
+      if (cached && cached.expires > Date.now()) return cached.value;
+      const value = await connections.probeUsage(companyId, userId, account.id, account.grantId).catch(() => null);
+      if (value) {
+        const resets = value.limits.map((limit) => Date.parse(limit.resetsAt ?? "")).filter((t) => Number.isFinite(t) && t > Date.now());
+        if (usageCache.size > 1000) usageCache.clear();
+        usageCache.set(key, { value, expires: Math.min(Date.now() + USAGE_TTL_MS, ...resets) });
+      }
+      return value;
+    },
+  };
+}
+
+const health = new Map<string, ControllerHealth>();
+export function controllerHealth(companyId: string) {
+  return health.get(companyId) ?? null;
+}
+
+export function providerRoutingService(db: Db, options: { usage?: UsageSource } = {}) {
+  const usage = options.usage ?? officialUsageSource(db);
+
+  async function readPolicy(companyId: string, client: Pick<Db, "select"> = db): Promise<RoutingPolicy> {
+    const [row] = await client
+      .select({ details: activityLog.details })
+      .from(activityLog)
+      .where(and(
+        eq(activityLog.companyId, companyId),
+        eq(activityLog.entityType, "company"),
+        eq(activityLog.entityId, companyId),
+        eq(activityLog.action, POLICY_UPDATED_ACTION),
+      ))
+      .orderBy(desc(activityLog.createdAt), desc(activityLog.id))
+      .limit(1);
+    if (!row) return defaultPolicy();
+    const stored = asRecord(asRecord(row.details).policy);
+    const parsed = routingPolicyInputSchema.safeParse({
+      enabled: stored.enabled, mode: stored.mode, thresholdPercent: stored.thresholdPercent,
+      providers: stored.providers, tiers: stored.tiers, modelTiers: stored.modelTiers,
+    });
+    // An unreadable entry turns routing off rather than guessing.
+    if (!parsed.success) return { ...defaultPolicy(), revision: Number(stored.revision) || 0 };
+    return {
+      ...parsed.data,
+      revision: Number(stored.revision) || 0,
+      updatedAt: typeof stored.updatedAt === "string" ? stored.updatedAt : null,
+      updatedBy: typeof stored.updatedBy === "string" ? stored.updatedBy : null,
+    };
+  }
+
+  async function companyAgents(companyId: string, client: Pick<Db, "select"> = db) {
+    return client.select().from(agents).where(eq(agents.companyId, companyId)).orderBy(agents.createdAt, agents.id);
+  }
+
+  async function savePolicy(companyId: string, expectedRevision: number, input: RoutingPolicyInput, actor: RoutingActor) {
+    const next = withTierMemberships(routingPolicyInputSchema.parse(input));
+    return db.transaction(async (tx) => {
+      await tx.execute(sql`select pg_advisory_xact_lock(hashtext(${`ppclip.provider_routing:${companyId}`}))`);
+      const current = await readPolicy(companyId, tx);
+      if (current.revision !== expectedRevision) {
+        throw conflict("Provider settings changed in another window. Reload before saving.");
+      }
+      const team = await companyAgents(companyId, tx);
+      for (const provider of next.providers) {
+        const template = team.find((agent) => agent.id === provider.templateAgentId);
+        if (!template || template.status === "terminated") {
+          throw unprocessable(`Choose an active ${provider.adapterType} agent as that provider's template.`);
+        }
+        if (ownHarness(template).adapterType !== provider.adapterType) {
+          throw unprocessable(`The ${provider.adapterType} template agent must use ${provider.adapterType}.`);
+        }
+      }
+      const policy: RoutingPolicy = {
+        ...next,
+        revision: current.revision + 1,
+        updatedAt: new Date().toISOString(),
+        updatedBy: actor.actorId,
+      };
+      await logActivity(tx as unknown as Db, {
+        companyId,
+        actorType: actor.actorType,
+        actorId: actor.actorId,
+        action: POLICY_UPDATED_ACTION,
+        entityType: "company",
+        entityId: companyId,
+        details: { policy, enabledChanged: current.enabled !== policy.enabled, modeChanged: current.mode !== policy.mode },
+      });
+      return policy;
+    });
+  }
+
+  async function status(companyId: string): Promise<ProviderRoutingStatus> {
+    const [policy, team] = await Promise.all([readPolicy(companyId), companyAgents(companyId)]);
+    const byType = new Map<string, { id: string; name: string }[]>();
+    for (const agent of team) {
+      if (agent.status === "terminated") continue;
+      const own = ownHarness(agent).adapterType;
+      if (!isRoutableAdapter(own)) continue;
+      byType.set(own, [...(byType.get(own) ?? []), { id: agent.id, name: agent.name }]);
+    }
+    for (const provider of policy.providers) if (!byType.has(provider.adapterType)) byType.set(provider.adapterType, []);
+    const candidates = [...byType.entries()]
+      .map(([adapterType, list]) => ({ adapterType, agents: list }))
+      .sort((a, b) => a.adapterType.localeCompare(b.adapterType));
+    const routedAgents = team.flatMap((agent) => {
+      const record = readRoutingRecord(agent.metadata);
+      return record ? [{ agentId: agent.id, name: agent.name, adapterType: agent.adapterType, primaryAdapterType: record.primary.adapterType }] : [];
+    });
+    return { policy, candidates, routedAgents, controller: { intervalMs: CONTROLLER_INTERVAL_MS, health: controllerHealth(companyId) } };
+  }
+
+  /** Accept the agent's current settings as its own and forget the saved original. */
+  async function release(companyId: string, agentId: string, actor: RoutingActor) {
+    return db.transaction(async (tx) => {
+      await tx.execute(sql`select pg_advisory_xact_lock(hashtext(${`ppclip.provider_routing:${companyId}`}))`);
+      const [agent] = await tx.select().from(agents)
+        .where(and(eq(agents.id, agentId), eq(agents.companyId, companyId))).for("update");
+      if (!agent) throw notFound("Agent not found");
+      const record = readRoutingRecord(agent.metadata);
+      if (!record) return { agentId, released: false };
+      await tx.update(agents).set({ metadata: withRoutingRecord(agent.metadata, null), updatedAt: new Date() }).where(eq(agents.id, agentId));
+      await logActivity(tx as unknown as Db, {
+        companyId, actorType: actor.actorType, actorId: actor.actorId, action: AGENT_RELEASED_ACTION,
+        entityType: "agent", entityId: agentId, agentId,
+        details: { adapterType: agent.adapterType, primaryAdapterType: record.primary.adapterType },
+      });
+      return { agentId, released: true };
+    });
+  }
+
+  async function providerQuotas(companyId: string, policy: RoutingPolicy, team: AgentRow[]) {
+    const quotas = new Map<string, ProviderQuota>();
+    const userId = policy.updatedBy;
+    const accounts = userId ? await usage.listAccounts(companyId, userId).catch(() => []) : [];
+    for (const provider of policy.providers) {
+      const aiProvider = aiProviderForAdapter(provider.adapterType);
+      const template = team.find((agent) => agent.id === provider.templateAgentId);
+      const binding = aiConnectionBindingSchema.safeParse(template ? ownHarness(template).aiConnection : null);
+      const pinned = binding.success && binding.data.mode === "shared" ? binding.data : null;
+      const matching = accounts.filter((account) =>
+        account.provider === aiProvider
+        && account.status === "connected"
+        && account.usageProbeSupported !== false
+        && (!pinned || (account.id === pinned.connectionId && account.grantId === pinned.grantId)));
+      const observations: AiConnectionUsage[] = [];
+      for (const account of matching) {
+        const observed = userId ? await usage.probe(companyId, userId, account) : null;
+        if (observed) observations.push(observed);
+      }
+      quotas.set(provider.adapterType, {
+        adapterType: provider.adapterType,
+        state: providerQuotaState(observations, policy.thresholdPercent),
+        accounts: matching.length,
+      });
+    }
+    return quotas;
+  }
+
+  async function liveRunAgents(companyId: string) {
+    const rows = await db.selectDistinct({ agentId: heartbeatRuns.agentId }).from(heartbeatRuns)
+      .where(and(eq(heartbeatRuns.companyId, companyId), inArray(heartbeatRuns.status, LIVE_RUN_STATUSES)));
+    return new Set(rows.map((row) => row.agentId));
+  }
+
+  async function taskModelOverride(agentId: string, client: Pick<Db, "select"> = db) {
+    const rows = await client.select({ identifier: issues.identifier, overrides: issues.assigneeAdapterOverrides }).from(issues)
+      .where(and(
+        eq(issues.assigneeAgentId, agentId),
+        notInArray(issues.status, CLOSED_TASK_STATUSES),
+        isNotNull(issues.assigneeAdapterOverrides),
+      ));
+    return rows.find((row) => {
+      const config = asRecord(asRecord(row.overrides).adapterConfig);
+      return ["model", "effort", "modelReasoningEffort", "reasoningEffort"].some((key) => config[key] !== undefined);
+    }) ?? null;
+  }
+
+  /** One controller pass for a company. Switches only idle agents, one transaction each. */
+  async function reconcile(companyId: string): Promise<ControllerHealth> {
+    const policy = await readPolicy(companyId);
+    const checkedAt = new Date().toISOString();
+    if (!policy.enabled) {
+      const off: ControllerHealth = { checkedAt, revision: policy.revision, agents: [], quotas: [], error: null };
+      health.set(companyId, off);
+      return off;
+    }
+    const team = await companyAgents(companyId);
+    const quotas = await providerQuotas(companyId, policy, team);
+    const live = await liveRunAgents(companyId);
+    const providerTypes = policy.providers.map((p) => p.adapterType);
+    const results: AgentRoutingHealth[] = [];
+
+    for (const agent of team) {
+      const record = readRoutingRecord(agent.metadata);
+      if (agent.status === "terminated") continue;
+      if (!record && !providerTypes.includes(agent.adapterType)) continue;
+      const primary = record?.primary ?? withoutEnv(harnessOf(agent));
+      const report = (state: AgentRoutingHealth["state"], message: string) =>
+        results.push({ agentId: agent.id, state, message, adapterType: agent.adapterType, primaryAdapterType: primary.adapterType });
+      try {
+        if (WAITING_AGENT_STATUSES.has(agent.status) || live.has(agent.id)) {
+          report("waiting", agent.status === "paused" ? "Paused agents stay where they are." : "Switches after the current work finishes.");
+          continue;
+        }
+        if (record && configSignature(harnessOf(agent)) !== record.expected) {
+          report("blocked", "Settings changed outside routing. Keep the current settings or restore them before routing resumes.");
+          continue;
+        }
+        const primaryModel = typeof primary.adapterConfig.model === "string" ? primary.adapterConfig.model : null;
+        const templateFor = (type: string) => {
+          const provider = policy.providers.find((p) => p.adapterType === type);
+          const template = provider ? team.find((a) => a.id === provider.templateAgentId && a.status !== "terminated") : null;
+          return template ? ownHarness(template) : null;
+        };
+        const canMapTo = (type: string) =>
+          type === primary.adapterType
+          || (templateFor(type)?.adapterType === type && mapModel(policy, primary.adapterType, primaryModel, type).ok);
+        const decision = decideTarget({
+          mode: policy.mode,
+          primaryType: primary.adapterType,
+          currentType: agent.adapterType,
+          previousMode: record?.mode ?? null,
+          providers: providerTypes,
+          quota: (type) => quotas.get(type)?.state ?? "unknown",
+          canMapTo,
+        });
+        if (decision.target === agent.adapterType) {
+          report(record ? "switched" : "ready", record ? `Running on ${agent.adapterType} instead of ${primary.adapterType}.` : decision.reason);
+          continue;
+        }
+        const override = await taskModelOverride(agent.id);
+        if (override) {
+          report("blocked", `Task ${override.identifier ?? ""} has its own model or effort. Clear it before this agent can switch.`.replace("  ", " "));
+          continue;
+        }
+        const restoring = decision.target === primary.adapterType;
+        let next: HarnessConfig;
+        if (restoring) {
+          next = restoredConfig(harnessOf(agent), primary);
+        } else {
+          const template = templateFor(decision.target);
+          const mapping = mapModel(policy, primary.adapterType, primaryModel, decision.target);
+          if (!template || !mapping.ok) throw new Error(mapping.ok ? "The provider's template agent is unavailable." : mapping.reason);
+          if (!record) {
+            const own = primary.adapterConfig;
+            if (JSON.stringify(sanitizeRecord(own)) !== JSON.stringify(own)) {
+              throw new Error("This agent keeps credentials in its harness settings. Move them to Connections or secrets before routing.");
+            }
+          }
+          next = buildRoutedConfig({ agent: harnessOf(agent), primary, template, targetModel: mapping.model, supportedEfforts });
+        }
+        const applied = await apply(companyId, agent.id, agent.updatedAt, next, restoring ? null : { primary, mode: policy.mode }, decision.reason);
+        if (!applied) {
+          report("waiting", "The agent changed or started work; retrying on the next pass.");
+          continue;
+        }
+        report(restoring ? "ready" : "switched", restoring
+          ? `Restored to ${primary.adapterType}.`
+          : `Switched to ${next.adapterType} · ${String(next.adapterConfig.model)}.`);
+      } catch (error) {
+        report("blocked", error instanceof Error ? error.message : "Switching failed.");
+      }
+    }
+    const result: ControllerHealth = {
+      checkedAt,
+      revision: policy.revision,
+      agents: results,
+      quotas: [...quotas.values()],
+      error: null,
+    };
+    health.set(companyId, result);
+    return result;
+  }
+
+  async function apply(
+    companyId: string,
+    agentId: string,
+    seenUpdatedAt: Date,
+    next: HarnessConfig,
+    routed: { primary: HarnessConfig; mode: string } | null,
+    reason: string,
+  ) {
+    return db.transaction(async (tx) => {
+      await tx.execute(sql`select pg_advisory_xact_lock(hashtext(${`ppclip.provider_routing:${companyId}`}))`);
+      const [fresh] = await tx.select().from(agents).where(and(eq(agents.id, agentId), eq(agents.companyId, companyId))).for("update");
+      if (!fresh || fresh.updatedAt.getTime() !== seenUpdatedAt.getTime() || WAITING_AGENT_STATUSES.has(fresh.status)) return false;
+      const [liveRun] = await tx.select({ id: heartbeatRuns.id }).from(heartbeatRuns)
+        .where(and(eq(heartbeatRuns.agentId, agentId), inArray(heartbeatRuns.status, LIVE_RUN_STATUSES))).limit(1);
+      if (liveRun) return false;
+      const runtimeConfig = { ...asRecord(fresh.runtimeConfig) };
+      if (next.aiConnection) runtimeConfig.aiConnection = next.aiConnection;
+      else delete runtimeConfig.aiConnection;
+      // Official's in-transaction configuration update normalizes secrets and runner
+      // config, records a config revision, and resets sessions because the harness changes.
+      const updated = await updateAgentConfigurationInTransaction(
+        tx as unknown as Db,
+        agentId,
+        { adapterType: next.adapterType, adapterConfig: next.adapterConfig, runtimeConfig },
+        { recordRevision: { source: "ppclip_provider_routing" } },
+      );
+      if (!updated) return false;
+      // Sign the stored row exactly as later passes read it.
+      const [stored] = await tx.select().from(agents).where(eq(agents.id, agentId));
+      if (!stored) return false;
+      const previous = readRoutingRecord(fresh.metadata);
+      const record = routed
+        ? { primary: previous?.primary ?? routed.primary, expected: configSignature(harnessOf(stored)), mode: routed.mode, switchedAt: new Date().toISOString() }
+        : null;
+      await tx.update(agents).set({ metadata: withRoutingRecord(stored.metadata, record) }).where(eq(agents.id, agentId));
+      await logActivity(tx as unknown as Db, {
+        companyId, actorType: "system", actorId: "ppclip-provider-routing", action: AGENT_SWITCHED_ACTION,
+        entityType: "agent", entityId: agentId, agentId,
+        details: {
+          from: fresh.adapterType, to: next.adapterType,
+          model: typeof next.adapterConfig.model === "string" ? next.adapterConfig.model : null,
+          restored: routed === null, reason,
+        },
+      });
+      return true;
+    });
+  }
+
+  async function enabledCompanyIds() {
+    const rows = await db.selectDistinct({ companyId: activityLog.companyId }).from(activityLog)
+      .where(eq(activityLog.action, POLICY_UPDATED_ACTION));
+    const enabled: string[] = [];
+    for (const row of rows) if ((await readPolicy(row.companyId)).enabled) enabled.push(row.companyId);
+    return enabled;
+  }
+
+  return { readPolicy, savePolicy, status, release, reconcile, enabledCompanyIds };
+}
+
+/**
+ * The controller runs inside the server as a periodic job, so it shares the
+ * server's database and can never read a different policy than the API wrote.
+ * It only acts for companies that turned routing on (off by default).
+ */
+export function startProviderRoutingController(
+  db: Db,
+  options: { intervalMs?: number; isPaused?: () => boolean; onError?: (error: unknown) => void } = {},
+) {
+  const service = providerRoutingService(db);
+  let running = false;
+  const tick = async () => {
+    if (running || options.isPaused?.()) return;
+    if (!ppclipFeature("providerRouting")) return;
+    running = true;
+    try {
+      for (const companyId of await service.enabledCompanyIds()) {
+        await service.reconcile(companyId).catch((error) => {
+          health.set(companyId, {
+            checkedAt: new Date().toISOString(), revision: 0, agents: [], quotas: [],
+            error: error instanceof Error ? error.message : "Controller pass failed.",
+          });
+          options.onError?.(error);
+        });
+      }
+    } catch (error) {
+      options.onError?.(error);
+    } finally {
+      running = false;
+    }
+  };
+  const timer = setInterval(() => void tick(), options.intervalMs ?? CONTROLLER_INTERVAL_MS);
+  timer.unref?.();
+  return { tick, stop: () => clearInterval(timer) };
+}
diff --git a/server/src/ppclip/run-controls/credit.ts b/server/src/ppclip/run-controls/credit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..45e81415a9f0fefefa2b6f3cd0ef4f0b0c89c48d
--- /dev/null
+++ b/server/src/ppclip/run-controls/credit.ts
@@ -0,0 +1,14 @@
+import { activeRunCredit, readRunControl, utcDay } from "./state.js";
+import { ppclipFeature } from "../features.js";
+
+/**
+ * ppclip RUN-1 hook for official's daily cap check: runs made while Unlimited was
+ * on are stored as a credit for that UTC day and extend only that day's cap, so the
+ * credit expires at the next UTC day without any controller running. A draining
+ * agent gets no credit: Drain's cap of 0 is a hard stop.
+ */
+export function ppclipRunCreditForDay(metadata: unknown, dayStart: Date) {
+  if (!ppclipFeature("runControls")) return 0;
+  if (readRunControl(metadata).draining) return 0;
+  return activeRunCredit(metadata, utcDay(dayStart));
+}
diff --git a/server/src/ppclip/run-controls/drain-after-claim.ts b/server/src/ppclip/run-controls/drain-after-claim.ts
new file mode 100644
index 0000000000000000000000000000000000000000..419ba69e07b58b8f75e2c528be9cb0615869ae86
--- /dev/null
+++ b/server/src/ppclip/run-controls/drain-after-claim.ts
@@ -0,0 +1,96 @@
+import { eq } from "drizzle-orm";
+import { agents, heartbeatRuns, type Db } from "@paperclipai/db";
+import { logActivity, publishActivity, type ActivityPublication } from "../../services/activity-log.js";
+import { publishLiveEvent } from "../../services/live-events.js";
+import { lockRunControlTeam, type DailyRunCapReader } from "./service.js";
+import { applyRunControl, isDrainAfterArmed, readDrainAfter, readRunControl, withDrainAfter } from "./state.js";
+import { ppclipFeature } from "../features.js";
+
+/**
+ * ppclip RUN-2: when an agent armed with "Drain after next run" has its run
+ * claimed, the whole team drains in the same transaction as the claim.
+ *
+ * Lock ordering. Official's claim transaction locks the issue, then the wakeup
+ * request, then the run. Run-control writes take the company advisory lock and
+ * then all company agent rows ordered by id (lockRunControlTeam). To keep one
+ * global order, the claim takes the run-control locks FIRST, before official's
+ * issue lock, but only when the claiming agent is armed (one primary-key read
+ * per claim otherwise). Official transactions that lock an agent row and then an
+ * issue (e.g. wakeup enqueue) can then only make the claim wait, never deadlock
+ * with it. If an agent is armed between that pre-check and the claim (a race of
+ * a few milliseconds), the post-claim hook still drains the team, taking the
+ * locks late; in that rare case Postgres' deadlock detector is the backstop and
+ * the claim retries on the next scheduler pass.
+ */
+
+type Tx = Parameters<typeof lockRunControlTeam>[0];
+type ClaimedRun = typeof heartbeatRuns.$inferSelect;
+
+const pendingEvents = new Map<string, { companyId: string; agentIds: string[]; publications: ActivityPublication[] }>();
+
+async function claimingAgentArmed(tx: Tx, agentId: string) {
+  const [agent] = await tx.select({ metadata: agents.metadata }).from(agents).where(eq(agents.id, agentId));
+  return isDrainAfterArmed(agent?.metadata);
+}
+
+/** Called at the start of the claim transaction, before official's issue lock. */
+export async function ppclipDrainAfterPreLock(tx: Tx, run: Pick<ClaimedRun, "companyId" | "agentId">) {
+  if (!ppclipFeature("runControls")) return;
+  if (await claimingAgentArmed(tx, run.agentId)) await lockRunControlTeam(tx, run.companyId);
+}
+
+/** Called inside the claim transaction right after the run row became "running". */
+export async function ppclipDrainAfterOnClaim(tx: Tx, claimed: ClaimedRun | null | undefined, readCap: DailyRunCapReader) {
+  if (!ppclipFeature("runControls")) return;
+  if (!claimed || claimed.status !== "running") return;
+  if (!(await claimingAgentArmed(tx, claimed.agentId))) return;
+  // Re-entrant when the pre-lock already ran: Postgres does not wait on locks it holds.
+  const team = await lockRunControlTeam(tx, claimed.companyId);
+  const self = team.find((agent) => agent.id === claimed.agentId);
+  if (!self || !isDrainAfterArmed(self.metadata)) return;
+  const now = new Date();
+  const changed: string[] = [];
+  for (const member of team) {
+    if (member.status === "terminated") continue;
+    const rc = readRunControl(member.metadata);
+    const patch = rc.draining
+      ? { metadata: { ...(member.metadata ?? {}) } as Record<string, unknown>, runtimeConfig: member.runtimeConfig }
+      : applyRunControl(member, { unlimited: Boolean(rc.unlimited), draining: true }, {
+          currentCap: readCap(member), now, actor: "drain-after", triggeredByRunId: claimed.id,
+        });
+    if (member.id === self.id) {
+      patch.metadata = withDrainAfter(patch.metadata, {
+        ...readDrainAfter(self.metadata)!, state: "triggered", runId: claimed.id, triggeredAt: now.toISOString(),
+      });
+    } else if (rc.draining) {
+      continue;
+    }
+    await tx.update(agents).set({ ...patch, updatedAt: now }).where(eq(agents.id, member.id));
+    changed.push(member.id);
+  }
+  const publications: ActivityPublication[] = [];
+  await logActivity(tx as unknown as Db, {
+    companyId: claimed.companyId,
+    actorType: "system",
+    actorId: "drain-after",
+    agentId: self.id,
+    runId: claimed.id,
+    action: "ppclip.run_controls.drain_after_triggered",
+    entityType: "agent",
+    entityId: self.id,
+    details: { runId: claimed.id, agentIds: changed },
+  }, publications);
+  pendingEvents.set(claimed.id, { companyId: claimed.companyId, agentIds: changed, publications });
+}
+
+/** Called after the claim transaction settled: publish only what was committed. */
+export function ppclipFlushDrainAfterEvents(runId: string, claimed: ClaimedRun | null | undefined) {
+  const pending = pendingEvents.get(runId);
+  if (!pending) return;
+  pendingEvents.delete(runId);
+  if (!claimed || claimed.status !== "running") return;
+  for (const publication of pending.publications) publishActivity(publication);
+  for (const agentId of pending.agentIds) {
+    publishLiveEvent({ companyId: pending.companyId, type: "agent.status", payload: { agentId, reason: "drain_after_triggered", runId } });
+  }
+}
diff --git a/server/src/ppclip/run-controls/routes.ts b/server/src/ppclip/run-controls/routes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7860d6766b88b05d4aca63c205110dd8b5699f38
--- /dev/null
+++ b/server/src/ppclip/run-controls/routes.ts
@@ -0,0 +1,96 @@
+import { Router, type Request } from "express";
+import { z } from "zod";
+import type { Db } from "@paperclipai/db";
+import { forbidden } from "../../errors.js";
+import { validate } from "../../middleware/validate.js";
+import { accessService } from "../../services/access.js";
+import { authorizationDeniedDetails } from "../../services/authorization.js";
+import { heartbeatService } from "../../services/heartbeat.js";
+import { assertBoard, assertCompanyAccess } from "../../routes/authz.js";
+import { runControlsService, type RunControlActor } from "./service.js";
+import { ppclipFeatureGate } from "../features.js";
+
+const switchSchema = z.object({ enabled: z.boolean() }).strict();
+const unlimitedSchema = z.object({ enabled: z.boolean() }).strict();
+const drainAfterSchema = z.object({ agentId: z.string().uuid(), armed: z.boolean() }).strict();
+
+/**
+ * ppclip run controls (RUN-1, RUN-2 and the master switch). Board only: reads
+ * need company access, writes need the same permission as managing agents
+ * (`agents:create`), and every write is activity-logged.
+ */
+export function ppclipRunControlRoutes(db: Db) {
+  const router = Router();
+  router.use("/companies/:companyId/ppclip/run-controls", ppclipFeatureGate("runControls"));
+  const access = accessService(db);
+  const heartbeat = heartbeatService(db);
+  const service = runControlsService(db, {
+    readCap: (agent) => heartbeat.parseHeartbeatPolicy(agent).maxDailyRuns,
+    wakeForResume: async (agentId, issueId, actor) => {
+      const run = await heartbeat.wakeup(agentId, {
+        source: "on_demand",
+        triggerDetail: "manual",
+        reason: "ppclip_run_controls_resume",
+        payload: { issueId },
+        requestedByActorType: actor.actorType === "system" ? "system" : actor.actorType,
+        requestedByActorId: actor.actorId,
+        contextSnapshot: { issueId, taskKey: issueId, triggeredBy: "board" },
+      });
+      return run ? { accepted: true } : { accepted: false, message: "A wake request was skipped." };
+    },
+  });
+
+  function readAccess(req: Request, companyId: string) {
+    assertBoard(req);
+    assertCompanyAccess(req, companyId);
+  }
+
+  async function writeAccess(req: Request, companyId: string): Promise<RunControlActor> {
+    readAccess(req, companyId);
+    const decision = await access.decide({
+      actor: req.actor,
+      action: "agents:create",
+      resource: { type: "company", companyId },
+    });
+    if (!decision.allowed) throw forbidden(decision.explanation, authorizationDeniedDetails(decision));
+    return { actorType: "user", actorId: req.actor.userId ?? "board" };
+  }
+
+  router.get("/companies/:companyId/ppclip/run-controls", async (req, res) => {
+    const companyId = req.params.companyId as string;
+    readAccess(req, companyId);
+    res.json(await service.overview(companyId));
+  });
+
+  router.put("/companies/:companyId/ppclip/run-controls", validate(switchSchema), async (req, res) => {
+    const companyId = req.params.companyId as string;
+    const actor = await writeAccess(req, companyId);
+    res.json(await service.setEnabled(companyId, req.body.enabled, actor));
+  });
+
+  router.post("/companies/:companyId/ppclip/run-controls/unlimited", validate(unlimitedSchema), async (req, res) => {
+    const companyId = req.params.companyId as string;
+    const actor = await writeAccess(req, companyId);
+    res.json(await service.setUnlimited(companyId, req.body.enabled, actor));
+  });
+
+  router.post("/companies/:companyId/ppclip/run-controls/drain", async (req, res) => {
+    const companyId = req.params.companyId as string;
+    const actor = await writeAccess(req, companyId);
+    res.json(await service.drain(companyId, actor));
+  });
+
+  router.post("/companies/:companyId/ppclip/run-controls/resume", async (req, res) => {
+    const companyId = req.params.companyId as string;
+    const actor = await writeAccess(req, companyId);
+    res.json(await service.resume(companyId, actor));
+  });
+
+  router.post("/companies/:companyId/ppclip/run-controls/drain-after", validate(drainAfterSchema), async (req, res) => {
+    const companyId = req.params.companyId as string;
+    const actor = await writeAccess(req, companyId);
+    res.json(await service.setDrainAfter(companyId, req.body.agentId, req.body.armed, actor));
+  });
+
+  return router;
+}
diff --git a/server/src/ppclip/run-controls/service.ts b/server/src/ppclip/run-controls/service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..42a5d8c46bd11959abe8d6209dde74db1a536b7d
--- /dev/null
+++ b/server/src/ppclip/run-controls/service.ts
@@ -0,0 +1,462 @@
+import { and, desc, eq, gte, inArray, lt, ne, notInArray, sql } from "drizzle-orm";
+import { activityLog, agents, heartbeatRuns, type Db } from "@paperclipai/db";
+import { conflict, notFound } from "../../errors.js";
+import { logActivity, publishActivity, type ActivityPublication } from "../../services/activity-log.js";
+import { publishLiveEvent } from "../../services/live-events.js";
+import {
+  activeRunCredit,
+  applyRunControl,
+  clearRunControls,
+  isDrainAfterArmed,
+  needsRunControlClear,
+  readDrainAfter,
+  readRunControl,
+  runsStartedSince,
+  utcDay,
+  utcDayStart,
+  withDrainAfter,
+} from "./state.js";
+
+type AgentRow = typeof agents.$inferSelect;
+type Tx = Pick<Db, "select" | "update" | "insert" | "execute">;
+
+/** Reads the cap exactly as official's scheduler does (heartbeat.ts parseHeartbeatPolicy). */
+export type DailyRunCapReader = (agent: AgentRow) => number | null;
+export type RunControlActor = { actorType: "user" | "agent" | "system"; actorId: string };
+export type ResumeWakeup = (agentId: string, issueId: string, actor: RunControlActor) => Promise<{ accepted: boolean; message?: string }>;
+
+export const RUN_CONTROLS_ENABLED_ACTION = "ppclip.run_controls.enabled";
+export const RUN_CONTROLS_DISABLED_ACTION = "ppclip.run_controls.disabled";
+const SWITCH_ACTIONS = [RUN_CONTROLS_ENABLED_ACTION, RUN_CONTROLS_DISABLED_ACTION];
+const NOT_STARTED_STATUSES = ["queued", "scheduled_retry"];
+const LIVE_STATUSES = ["queued", "running"];
+
+/**
+ * The per-company master switch is stored as its own audit trail: the latest
+ * `ppclip.run_controls.enabled|disabled` activity row for the company wins.
+ * No row means OFF (the default). This needs no migration and no extra settings
+ * column, survives upstream changes to company/instance settings, and is only
+ * deleted together with the company.
+ */
+export async function isRunControlsEnabled(db: Pick<Db, "select">, companyId: string) {
+  const [row] = await db
+    .select({ action: activityLog.action })
+    .from(activityLog)
+    .where(and(
+      eq(activityLog.companyId, companyId),
+      eq(activityLog.entityType, "company"),
+      eq(activityLog.entityId, companyId),
+      inArray(activityLog.action, SWITCH_ACTIONS),
+    ))
+    .orderBy(desc(activityLog.createdAt), desc(activityLog.id))
+    .limit(1);
+  return row?.action === RUN_CONTROLS_ENABLED_ACTION;
+}
+
+/**
+ * Lock order for every run-control write, including the drain-after claim hook:
+ * 1. a transaction-scoped advisory lock for the company (ppclip-only, so it never
+ *    meets official's company-row locks such as the issue counter or cost totals);
+ * 2. every agent row of the company, `FOR UPDATE`, ordered by id.
+ * Run-control writes never lock issue, wakeup or run rows while holding these.
+ */
+export async function lockRunControlTeam(tx: Tx, companyId: string) {
+  await tx.execute(sql`select pg_advisory_xact_lock(hashtext(${`ppclip.run_controls:${companyId}`}))`);
+  return tx.select().from(agents).where(eq(agents.companyId, companyId)).orderBy(agents.id).for("update");
+}
+
+function controlled(team: AgentRow[]) {
+  return team.filter((agent) => agent.status !== "terminated");
+}
+
+async function startedRunsToday(db: Pick<Db, "select">, companyId: string, now: Date) {
+  const start = utcDayStart(now);
+  const end = new Date(start.getTime() + 86_400_000);
+  return db
+    .select({ agentId: heartbeatRuns.agentId, startedAt: heartbeatRuns.startedAt })
+    .from(heartbeatRuns)
+    .where(and(
+      eq(heartbeatRuns.companyId, companyId),
+      gte(heartbeatRuns.startedAt, start),
+      lt(heartbeatRuns.startedAt, end),
+      notInArray(heartbeatRuns.status, NOT_STARTED_STATUSES),
+    ));
+}
+
+async function liveRunCounts(db: Pick<Db, "select">, companyId: string) {
+  const rows = await db
+    .select({ agentId: heartbeatRuns.agentId, count: sql<number>`count(*)::integer` })
+    .from(heartbeatRuns)
+    .where(and(eq(heartbeatRuns.companyId, companyId), inArray(heartbeatRuns.status, LIVE_STATUSES)))
+    .groupBy(heartbeatRuns.agentId);
+  return new Map(rows.map((row) => [row.agentId, Number(row.count)]));
+}
+
+export type AgentRunAllowance = {
+  agentId: string;
+  /** The agent's normal cap (null = unlimited); today's credit is not included. */
+  cap: number | null;
+  usedToday: number;
+  /** Runs made while Unlimited was on that do not count today. */
+  credit: number;
+  /** Runs left today, credit included (null = no cap). */
+  left: number | null;
+  unlimited: boolean;
+  draining: boolean;
+  drainState: "draining" | "drained" | null;
+  liveRuns: number;
+  drainAfterArmed: boolean;
+};
+
+export type TeamRunControlState = {
+  unlimited: "on" | "off" | "mixed";
+  drain: "off" | "draining" | "drained" | "mixed";
+  hasLiveWork: boolean;
+  drainAfterAgentId: string | null;
+};
+
+export type RunControlsOverview = {
+  enabled: boolean;
+  day: string;
+  resetsAt: string;
+  team: TeamRunControlState | null;
+  agents: AgentRunAllowance[];
+};
+
+/** Today's allowance per agent: started runs in the UTC day vs official's cap plus today's credit. */
+export function computeAllowance(
+  agent: AgentRow,
+  readCap: DailyRunCapReader,
+  runs: { agentId: string; startedAt: Date | string | null }[],
+  live: Map<string, number>,
+  now: Date,
+): AgentRunAllowance {
+  const day = utcDay(now);
+  const rc = readRunControl(agent.metadata);
+  const unlimited = Boolean(rc.unlimited);
+  const draining = Boolean(rc.draining);
+  const configuredCap = readCap(agent);
+  const cap = unlimited && !draining ? null : configuredCap;
+  const credit = draining ? 0 : activeRunCredit(agent.metadata, day);
+  const usedToday = runs.filter((run) => run.agentId === agent.id).length;
+  const left = cap === null ? null : Math.max(0, cap + credit - usedToday);
+  const liveRuns = live.get(agent.id) ?? 0;
+  return {
+    agentId: agent.id,
+    cap,
+    usedToday,
+    credit,
+    left,
+    unlimited,
+    draining,
+    drainState: draining ? (liveRuns > 0 ? "draining" : "drained") : null,
+    liveRuns,
+    drainAfterArmed: isDrainAfterArmed(agent.metadata),
+  };
+}
+
+export function summarizeTeam(rows: AgentRunAllowance[]): TeamRunControlState {
+  const unlimitedCount = rows.filter((row) => row.unlimited).length;
+  const drainingRows = rows.filter((row) => row.draining);
+  const hasLiveWork = rows.some((row) => row.liveRuns > 0);
+  let drain: TeamRunControlState["drain"] = "off";
+  if (rows.length > 0 && drainingRows.length === rows.length) {
+    drain = drainingRows.some((row) => row.liveRuns > 0) ? "draining" : "drained";
+  } else if (drainingRows.length > 0) {
+    drain = "mixed";
+  }
+  return {
+    unlimited: rows.length > 0 && unlimitedCount === rows.length ? "on" : unlimitedCount > 0 ? "mixed" : "off",
+    drain,
+    hasLiveWork,
+    drainAfterAgentId: rows.find((row) => row.drainAfterArmed)?.agentId ?? null,
+  };
+}
+
+export function runControlsService(db: Db, deps: { readCap: DailyRunCapReader; wakeForResume?: ResumeWakeup }) {
+  const { readCap } = deps;
+
+  async function inTeamTransaction<T>(
+    companyId: string,
+    fn: (tx: Tx, team: AgentRow[], publications: ActivityPublication[]) => Promise<T>,
+  ) {
+    const publications: ActivityPublication[] = [];
+    const result = await db.transaction(async (tx) => {
+      const team = await lockRunControlTeam(tx as unknown as Tx, companyId);
+      return fn(tx as unknown as Tx, team, publications);
+    });
+    // Activity events go out only after the state they describe is committed.
+    for (const publication of publications) publishActivity(publication);
+    return { result };
+  }
+
+  async function writeAgent(tx: Tx, agent: AgentRow, patch: { metadata: Record<string, unknown>; runtimeConfig?: Record<string, unknown> }, now: Date) {
+    await tx.update(agents).set({ ...patch, updatedAt: now }).where(eq(agents.id, agent.id));
+  }
+
+  function publishAgentChanges(companyId: string, team: AgentRow[], agentIds: string[], reason: string) {
+    for (const agentId of agentIds) {
+      const agent = team.find((row) => row.id === agentId);
+      publishLiveEvent({ companyId, type: "agent.status", payload: { agentId, status: agent?.status ?? null, reason } });
+    }
+  }
+
+  async function requireEnabled(tx: Tx, companyId: string) {
+    if (!(await isRunControlsEnabled(tx, companyId))) {
+      throw conflict("Run controls are turned off for this company. Turn them on in Company Settings first.", {
+        code: "ppclip_run_controls_disabled",
+      });
+    }
+  }
+
+  function log(tx: Tx, companyId: string, actor: RunControlActor, action: string, details: Record<string, unknown>, publications: ActivityPublication[], entity?: { type: string; id: string }) {
+    return logActivity(tx as unknown as Db, {
+      companyId,
+      actorType: actor.actorType,
+      actorId: actor.actorId,
+      action,
+      entityType: entity?.type ?? "company",
+      entityId: entity?.id ?? companyId,
+      details,
+    }, publications);
+  }
+
+  return {
+    isEnabled: (companyId: string) => isRunControlsEnabled(db, companyId),
+
+    overview: async (companyId: string, now = new Date()): Promise<RunControlsOverview> => {
+      const day = utcDay(now);
+      const resetsAt = new Date(utcDayStart(now).getTime() + 86_400_000).toISOString();
+      if (!(await isRunControlsEnabled(db, companyId))) return { enabled: false, day, resetsAt, team: null, agents: [] };
+      const [team, runs, live] = await Promise.all([
+        db.select().from(agents).where(and(eq(agents.companyId, companyId), ne(agents.status, "terminated"))),
+        startedRunsToday(db, companyId, now),
+        liveRunCounts(db, companyId),
+      ]);
+      const rows = team.map((agent) => computeAllowance(agent, readCap, runs, live, now));
+      return { enabled: true, day, resetsAt, team: summarizeTeam(rows), agents: rows };
+    },
+
+    /** Turning the switch off clears every daily cap and all run-control state. */
+    setEnabled: async (companyId: string, enabled: boolean, actor: RunControlActor) => {
+      const { result } = await inTeamTransaction(companyId, async (tx, team, publications) => {
+        const current = await isRunControlsEnabled(tx, companyId);
+        if (current === enabled) return { changed: false, clearedAgentIds: [] as string[], team };
+        const cleared: string[] = [];
+        if (!enabled) {
+          const now = new Date();
+          for (const agent of team) {
+            if (!needsRunControlClear(agent)) continue;
+            await writeAgent(tx, agent, clearRunControls(agent), now);
+            cleared.push(agent.id);
+          }
+        }
+        await log(tx, companyId, actor, enabled ? RUN_CONTROLS_ENABLED_ACTION : RUN_CONTROLS_DISABLED_ACTION,
+          { enabled, clearedAgentIds: cleared }, publications);
+        return { changed: true, clearedAgentIds: cleared, team };
+      });
+      publishAgentChanges(companyId, result.team, result.clearedAgentIds, "run_controls_disabled");
+      return { enabled, changed: result.changed, clearedAgentIds: result.clearedAgentIds };
+    },
+
+    setUnlimited: async (companyId: string, on: boolean, actor: RunControlActor) => {
+      const { result } = await inTeamTransaction(companyId, async (tx, team, publications) => {
+        await requireEnabled(tx, companyId);
+        const now = new Date();
+        const runs = on ? [] : await startedRunsToday(tx, companyId, now);
+        const changed: string[] = [];
+        const credited: Record<string, number> = {};
+        for (const agent of controlled(team)) {
+          const rc = readRunControl(agent.metadata);
+          if (Boolean(rc.unlimited) === on) continue;
+          const creditRuns = on ? 0 : runsStartedSince(runs, agent.id, rc.unlimitedSince, now);
+          if (creditRuns > 0) credited[agent.id] = creditRuns;
+          await writeAgent(tx, agent, applyRunControl(agent, { unlimited: on, draining: Boolean(rc.draining) }, {
+            currentCap: readCap(agent), now, actor: actor.actorId, creditRuns,
+          }), now);
+          changed.push(agent.id);
+        }
+        await log(tx, companyId, actor, on ? "ppclip.run_controls.unlimited_on" : "ppclip.run_controls.unlimited_off",
+          { agentIds: changed, ...(on ? {} : { creditedRuns: credited }) }, publications);
+        return { changed, team };
+      });
+      publishAgentChanges(companyId, result.team, result.changed, on ? "run_controls_unlimited_on" : "run_controls_unlimited_off");
+      return { agentIds: result.changed };
+    },
+
+    /** Drain: running work finishes; caps go to 0 and wake-on-demand off, so nothing new starts. */
+    drain: async (companyId: string, actor: RunControlActor) => {
+      const { result } = await inTeamTransaction(companyId, async (tx, team, publications) => {
+        await requireEnabled(tx, companyId);
+        const now = new Date();
+        const changed: string[] = [];
+        for (const agent of controlled(team)) {
+          const rc = readRunControl(agent.metadata);
+          const armed = isDrainAfterArmed(agent.metadata);
+          if (rc.draining && !armed) continue;
+          const patch = rc.draining
+            ? { metadata: { ...(agent.metadata ?? {}) } as Record<string, unknown> }
+            : applyRunControl(agent, { unlimited: Boolean(rc.unlimited), draining: true }, {
+                currentCap: readCap(agent), now, actor: actor.actorId,
+              });
+          if (armed) patch.metadata = withDrainAfter(patch.metadata, { ...readDrainAfter(agent.metadata)!, state: "cancelled", cancelledAt: now.toISOString() });
+          await writeAgent(tx, agent, patch, now);
+          changed.push(agent.id);
+        }
+        await log(tx, companyId, actor, "ppclip.run_controls.drained", { agentIds: changed }, publications);
+        return { changed, team };
+      });
+      publishAgentChanges(companyId, result.team, result.changed, "run_controls_drain");
+      return { agentIds: result.changed };
+    },
+
+    /**
+     * Resume: restore each drained agent's own cap and wake setting, cancel an armed
+     * drain-after, then wake one eligible assigned task per agent (in progress first,
+     * unblocked, agent not paused/errored and without live work).
+     */
+    resume: async (companyId: string, actor: RunControlActor) => {
+      const { result } = await inTeamTransaction(companyId, async (tx, team, publications) => {
+        await requireEnabled(tx, companyId);
+        const now = new Date();
+        const changed: string[] = [];
+        for (const agent of controlled(team)) {
+          const rc = readRunControl(agent.metadata);
+          const armed = isDrainAfterArmed(agent.metadata);
+          if (!rc.draining && !armed) continue;
+          const patch = rc.draining
+            ? applyRunControl(agent, { unlimited: Boolean(rc.unlimited), draining: false }, {
+                currentCap: readCap(agent), now, actor: actor.actorId,
+              })
+            : { metadata: { ...(agent.metadata ?? {}) } as Record<string, unknown> };
+          if (armed) patch.metadata = withDrainAfter(patch.metadata, { ...readDrainAfter(agent.metadata)!, state: "cancelled", cancelledAt: now.toISOString() });
+          await writeAgent(tx, agent, patch, now);
+          changed.push(agent.id);
+        }
+        return { changed, team };
+      });
+      publishAgentChanges(companyId, result.team, result.changed, "run_controls_resume");
+
+      const wakes = { accepted: 0, skipped: [] as string[] };
+      const eligibleAgents = controlled(result.team)
+        .filter((agent) => !["paused", "error", "pending_approval"].includes(agent.status))
+        .map((agent) => agent.id);
+      const live = await liveRunCounts(db, companyId);
+      const idleAgents = eligibleAgents.filter((agentId) => !live.get(agentId));
+      if (deps.wakeForResume && idleAgents.length > 0) {
+        for (const assignment of await selectResumeAssignments(db, companyId, idleAgents)) {
+          try {
+            const outcome = await deps.wakeForResume(assignment.agentId, assignment.issueId, actor);
+            if (outcome.accepted) wakes.accepted += 1;
+            else wakes.skipped.push(outcome.message ?? "A wake request was skipped.");
+          } catch (error) {
+            wakes.skipped.push(error instanceof Error ? error.message : String(error));
+          }
+        }
+      }
+      await logActivity(db, {
+        companyId, actorType: actor.actorType, actorId: actor.actorId,
+        action: "ppclip.run_controls.resumed", entityType: "company", entityId: companyId,
+        details: { agentIds: result.changed, wakesAccepted: wakes.accepted, wakesSkipped: wakes.skipped.length },
+      });
+      return { agentIds: result.changed, wakes };
+    },
+
+    /** RUN-2: arm or cancel "drain the whole team when this agent's next run starts". */
+    setDrainAfter: async (companyId: string, agentId: string, armed: boolean, actor: RunControlActor) => {
+      const { result } = await inTeamTransaction(companyId, async (tx, team, publications) => {
+        const agent = team.find((row) => row.id === agentId);
+        if (!agent || agent.status === "terminated") throw notFound("Agent not found");
+        const current = readDrainAfter(agent.metadata);
+        const now = new Date();
+        if (!armed) {
+          if (current?.state !== "armed") return { agent, changed: false };
+          await writeAgent(tx, agent, { metadata: withDrainAfter(agent.metadata, { ...current, state: "cancelled", cancelledAt: now.toISOString() }) }, now);
+          await log(tx, companyId, actor, "ppclip.run_controls.drain_after_cancelled", { agentId }, publications, { type: "agent", id: agentId });
+          return { agent, changed: true };
+        }
+        await requireEnabled(tx, companyId);
+        if (current?.state === "armed") return { agent, changed: false };
+        await assertDrainAfterEligible(tx, companyId, agent, team, readCap);
+        await writeAgent(tx, agent, {
+          metadata: withDrainAfter(agent.metadata, { state: "armed", armedAt: now.toISOString(), armedBy: actor.actorId }),
+        }, now);
+        await log(tx, companyId, actor, "ppclip.run_controls.drain_after_armed", { agentId }, publications, { type: "agent", id: agentId });
+        return { agent, changed: true };
+      });
+      if (result.changed) publishAgentChanges(companyId, [result.agent], [agentId], "drain_after_changed");
+      return { agentId, armed, changed: result.changed };
+    },
+  };
+}
+
+/**
+ * Arming needs an agent that is waiting only on another agent: idle, allowed to
+ * run, with no live run, a blocked task whose open blocker belongs to someone
+ * else, and no pending approval or human-only question. One plan per company.
+ */
+async function assertDrainAfterEligible(tx: Tx, companyId: string, agent: AgentRow, team: AgentRow[], readCap: DailyRunCapReader) {
+  const rc = readRunControl(agent.metadata);
+  const heartbeat = (agent.runtimeConfig as Record<string, unknown> | null)?.heartbeat as Record<string, unknown> | undefined;
+  if (!["idle", "active"].includes(agent.status) || rc.draining || readCap(agent) === 0 || heartbeat?.wakeOnDemand === false) {
+    throw conflict("Choose an idle agent while the team is allowed to run.", { code: "ppclip_drain_after_ineligible" });
+  }
+  if (team.some((other) => other.id !== agent.id && isDrainAfterArmed(other.metadata))) {
+    throw conflict("Another drain-after is armed. Cancel it first.", { code: "ppclip_drain_after_already_armed" });
+  }
+  const live = await tx.select({ id: heartbeatRuns.id }).from(heartbeatRuns)
+    .where(and(eq(heartbeatRuns.agentId, agent.id), eq(heartbeatRuns.status, "running"))).limit(1);
+  if (live.length > 0) {
+    throw conflict("This agent has already started. Use Drain to finish current runs.", { code: "ppclip_drain_after_running" });
+  }
+  const pending = await tx.execute(sql`
+    select 1 from issues i
+    join issue_relations r on r.related_issue_id = i.id and r.type = 'blocks'
+    join issues b on b.id = r.issue_id
+    where i.company_id = ${companyId} and r.company_id = ${companyId} and b.company_id = ${companyId}
+      and i.assignee_agent_id = ${agent.id} and i.status = 'blocked'
+      and b.status not in ('done', 'cancelled')
+      and b.assignee_agent_id is not null and b.assignee_agent_id <> ${agent.id}
+      and not exists (
+        select 1 from approvals a
+        where a.company_id = ${companyId} and a.requested_by_agent_id = ${agent.id} and a.status = 'pending')
+      and not exists (
+        select 1 from issue_thread_interactions h join issues hi on hi.id = h.issue_id
+        where h.company_id = ${companyId} and hi.company_id = ${companyId}
+          and hi.status in ('todo', 'in_progress', 'in_review', 'blocked') and h.status = 'pending'
+          and h.kind in ('request_confirmation', 'request_checkbox_confirmation', 'request_item_verdicts', 'ask_user_questions')
+          and h.effective_resolver_policy in ('human_only', 'board_only')
+          and coalesce(h.created_by_agent_id, hi.assignee_agent_id) = ${agent.id})
+    limit 1`);
+  if (rowsOf(pending).length === 0) {
+    throw conflict("This agent is not waiting only on another agent, or it needs a human decision. Refresh and try again.", {
+      code: "ppclip_drain_after_not_pending",
+    });
+  }
+}
+
+function rowsOf(result: unknown): unknown[] {
+  if (Array.isArray(result)) return result;
+  const rows = (result as { rows?: unknown[] } | null)?.rows;
+  return Array.isArray(rows) ? rows : [];
+}
+
+/** One open, unblocked todo/in-progress task per agent; in-progress first, then most recently updated. */
+export async function selectResumeAssignments(db: Pick<Db, "execute">, companyId: string, agentIds: string[]) {
+  if (agentIds.length === 0) return [];
+  const result = await db.execute(sql`
+    select distinct on (i.assignee_agent_id) i.id as issue_id, i.assignee_agent_id as agent_id
+    from issues i
+    where i.company_id = ${companyId}
+      and i.assignee_agent_id in (${sql.join(agentIds.map((id) => sql`${id}::uuid`), sql`, `)})
+      and i.status in ('todo', 'in_progress') and i.hidden_at is null
+      and not exists (
+        select 1 from issue_relations r join issues b on b.id = r.issue_id
+        where r.company_id = ${companyId} and r.related_issue_id = i.id and r.type = 'blocks'
+          and b.status not in ('done', 'cancelled'))
+    order by i.assignee_agent_id, (i.status = 'in_progress') desc, i.updated_at desc`);
+  return rowsOf(result).map((row) => {
+    const record = row as { issue_id: string; agent_id: string };
+    return { issueId: record.issue_id, agentId: record.agent_id };
+  });
+}
diff --git a/server/src/ppclip/run-controls/state.ts b/server/src/ppclip/run-controls/state.ts
new file mode 100644
index 0000000000000000000000000000000000000000..54cc05a3a14e35b531c0474f0417fcad539444c5
--- /dev/null
+++ b/server/src/ppclip/run-controls/state.ts
@@ -0,0 +1,233 @@
+/**
+ * ppclip RUN-1 / RUN-2: pure helpers for team run controls.
+ *
+ * State lives in existing agent JSON columns (no migration):
+ * - `runtimeConfig.heartbeat.maxDailyRuns` / `wakeOnDemand`: the values official's
+ *   scheduler already enforces. Run controls only rewrite them.
+ * - `metadata.runControl`: what Unlimited/Drain changed, so Resume and turning
+ *   Unlimited off can restore the agent's own settings, plus today's run credit.
+ * - `metadata.drainAfter`: the RUN-2 "drain after next run" plan.
+ *
+ * Both metadata keys are owned by the board-only run-control endpoints; ordinary
+ * agent PATCHes and hires cannot change them (see preserveRunControlMetadata).
+ */
+
+/** Official's cap key and the legacy aliases it still reads (heartbeat.ts parseHeartbeatPolicy). */
+export const DAILY_RUN_CAP_KEYS = ["maxDailyRuns", "dailyRunLimit", "dailyRunCap", "maxRunsPerDay"] as const;
+export const RUN_CONTROL_METADATA_KEY = "runControl";
+export const DRAIN_AFTER_METADATA_KEY = "drainAfter";
+const PROTECTED_METADATA_KEYS = [RUN_CONTROL_METADATA_KEY, DRAIN_AFTER_METADATA_KEY] as const;
+
+/** Runs made while Unlimited was on, credited back to that UTC day's allowance. */
+export type RunCredit = { day: string; runs: number };
+/** The agent's own settings, saved while Unlimited or Drain overrides them. `null` = key was absent. */
+export type SavedHeartbeat = { maxDailyRuns: number | null; wakeOnDemand: boolean | null };
+export type RunControlState = {
+  unlimited?: boolean;
+  unlimitedSince?: string;
+  draining?: boolean;
+  drainingSince?: string;
+  saved?: SavedHeartbeat;
+  credit?: RunCredit;
+  triggeredByRunId?: string;
+  updatedAt?: string;
+  updatedBy?: string;
+};
+export type DrainAfterState = {
+  state: "armed" | "triggered" | "cancelled";
+  armedAt?: string;
+  armedBy?: string;
+  runId?: string;
+  triggeredAt?: string;
+  cancelledAt?: string;
+};
+
+type JsonRecord = Record<string, unknown>;
+type AgentConfigLike = { metadata: unknown; runtimeConfig: unknown };
+
+function asRecord(value: unknown): JsonRecord {
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as JsonRecord) : {};
+}
+
+export function utcDay(now = new Date()) {
+  return now.toISOString().slice(0, 10);
+}
+
+export function utcDayStart(now = new Date()) {
+  return new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
+}
+
+export function readRunControl(metadata: unknown): RunControlState {
+  return asRecord(asRecord(metadata)[RUN_CONTROL_METADATA_KEY]) as RunControlState;
+}
+
+export function readDrainAfter(metadata: unknown): DrainAfterState | null {
+  const value = asRecord(asRecord(metadata)[DRAIN_AFTER_METADATA_KEY]);
+  return typeof value.state === "string" ? (value as DrainAfterState) : null;
+}
+
+export function isDrainAfterArmed(metadata: unknown) {
+  return readDrainAfter(metadata)?.state === "armed";
+}
+
+/** Today's credit only: a credit from an earlier UTC day has expired. */
+export function activeRunCredit(metadata: unknown, day: string): number {
+  const credit = readRunControl(metadata).credit;
+  if (!credit || credit.day !== day) return 0;
+  const runs = typeof credit.runs === "number" && Number.isFinite(credit.runs) ? Math.floor(credit.runs) : 0;
+  return Math.max(0, runs);
+}
+
+/** Any daily cap key (official or legacy alias) is present. */
+export function hasDailyRunCap(runtimeConfig: unknown) {
+  const heartbeat = asRecord(asRecord(runtimeConfig).heartbeat);
+  return DAILY_RUN_CAP_KEYS.some((key) => Object.prototype.hasOwnProperty.call(heartbeat, key));
+}
+
+type RunRow = { agentId: string; startedAt: Date | string | null };
+
+/** Runs an agent started today (UTC) at or after `since`; the caller passes started runs only. */
+export function runsStartedSince(runs: RunRow[], agentId: string, since: string | null | undefined, now = new Date()) {
+  if (!since) return 0;
+  const sinceMs = Date.parse(since);
+  if (!Number.isFinite(sinceMs)) return 0;
+  const from = Math.max(utcDayStart(now).getTime(), sinceMs);
+  return runs.filter((run) => {
+    if (run.agentId !== agentId || !run.startedAt) return false;
+    const at = new Date(run.startedAt).getTime();
+    return at >= from && at <= now.getTime();
+  }).length;
+}
+
+export type RunControlTarget = { unlimited: boolean; draining: boolean };
+export type RunControlContext = {
+  /** The agent's current cap as official's scheduler reads it (null = no cap). */
+  currentCap: number | null;
+  now: Date;
+  actor: string;
+  /** Runs to add to today's credit (runs made while Unlimited was on). */
+  creditRuns?: number;
+  triggeredByRunId?: string;
+};
+
+function restoreKey(heartbeat: JsonRecord, key: string, value: unknown) {
+  if (value === null || value === undefined) delete heartbeat[key];
+  else heartbeat[key] = value;
+}
+
+/**
+ * Move an agent to the target Unlimited/Drain state. Unlimited and Drain are
+ * independent; the agent's own cap and wake setting are saved on the first
+ * override and restored when neither is on.
+ */
+export function applyRunControl(agent: AgentConfigLike, target: RunControlTarget, ctx: RunControlContext) {
+  const metadata = { ...asRecord(agent.metadata) };
+  const runtimeConfig = { ...asRecord(agent.runtimeConfig) };
+  const heartbeat = { ...asRecord(runtimeConfig.heartbeat) };
+  const current = readRunControl(metadata);
+  const wasActive = Boolean(current.unlimited || current.draining);
+  const willBeActive = target.unlimited || target.draining;
+  const saved: SavedHeartbeat = wasActive && current.saved
+    ? current.saved
+    : {
+        maxDailyRuns: ctx.currentCap,
+        wakeOnDemand: typeof heartbeat.wakeOnDemand === "boolean" ? heartbeat.wakeOnDemand : null,
+      };
+  const day = utcDay(ctx.now);
+  const creditRuns = activeRunCredit(metadata, day) + Math.max(0, Math.floor(ctx.creditRuns ?? 0));
+  const nowIso = ctx.now.toISOString();
+
+  for (const key of DAILY_RUN_CAP_KEYS) delete heartbeat[key];
+  if (target.draining) {
+    heartbeat.maxDailyRuns = 0;
+    heartbeat.wakeOnDemand = false;
+  } else {
+    if (!target.unlimited) restoreKey(heartbeat, "maxDailyRuns", saved.maxDailyRuns);
+    restoreKey(heartbeat, "wakeOnDemand", saved.wakeOnDemand);
+  }
+  runtimeConfig.heartbeat = heartbeat;
+
+  const credit = creditRuns > 0 ? { credit: { day, runs: creditRuns } } : {};
+  if (willBeActive) {
+    const next: RunControlState = {
+      ...(target.unlimited
+        ? { unlimited: true, unlimitedSince: current.unlimited && current.unlimitedSince ? current.unlimitedSince : nowIso }
+        : {}),
+      ...(target.draining
+        ? { draining: true, drainingSince: current.draining && current.drainingSince ? current.drainingSince : nowIso }
+        : {}),
+      saved,
+      ...credit,
+      ...(target.draining && (ctx.triggeredByRunId ?? current.triggeredByRunId)
+        ? { triggeredByRunId: ctx.triggeredByRunId ?? current.triggeredByRunId }
+        : {}),
+      updatedAt: nowIso,
+      updatedBy: ctx.actor,
+    };
+    metadata[RUN_CONTROL_METADATA_KEY] = next;
+  } else if (creditRuns > 0) {
+    // Limits are back; only today's credit remains and it expires on its own at the next UTC day.
+    metadata[RUN_CONTROL_METADATA_KEY] = { ...credit, updatedAt: nowIso, updatedBy: ctx.actor };
+  } else {
+    delete metadata[RUN_CONTROL_METADATA_KEY];
+  }
+  return { metadata, runtimeConfig };
+}
+
+/**
+ * Master switch off: remove every daily cap (official key and aliases), drop all
+ * run-control and drain-after state, and put wakeOnDemand back to the agent's
+ * saved value when run controls had overridden it.
+ */
+export function clearRunControls(agent: AgentConfigLike) {
+  const metadata = { ...asRecord(agent.metadata) };
+  const runtimeConfig = { ...asRecord(agent.runtimeConfig) };
+  const heartbeat = { ...asRecord(runtimeConfig.heartbeat) };
+  const current = readRunControl(metadata);
+  for (const key of DAILY_RUN_CAP_KEYS) delete heartbeat[key];
+  if ((current.unlimited || current.draining) && current.saved) {
+    restoreKey(heartbeat, "wakeOnDemand", current.saved.wakeOnDemand);
+  }
+  runtimeConfig.heartbeat = heartbeat;
+  delete metadata[RUN_CONTROL_METADATA_KEY];
+  delete metadata[DRAIN_AFTER_METADATA_KEY];
+  return { metadata, runtimeConfig };
+}
+
+export function needsRunControlClear(agent: AgentConfigLike) {
+  const metadata = asRecord(agent.metadata);
+  return hasDailyRunCap(agent.runtimeConfig)
+    || Object.prototype.hasOwnProperty.call(metadata, RUN_CONTROL_METADATA_KEY)
+    || Object.prototype.hasOwnProperty.call(metadata, DRAIN_AFTER_METADATA_KEY);
+}
+
+export function withDrainAfter(metadata: unknown, next: DrainAfterState | null) {
+  const result = { ...asRecord(metadata) };
+  if (next) result[DRAIN_AFTER_METADATA_KEY] = next;
+  else delete result[DRAIN_AFTER_METADATA_KEY];
+  return result;
+}
+
+/**
+ * Ordinary agent updates keep the stored run-control and drain-after state, whatever
+ * the patch says: only the board run-control endpoints may change them.
+ */
+export function preserveRunControlMetadata(existing: unknown, next: unknown): JsonRecord | null {
+  const stored = asRecord(existing);
+  const kept = PROTECTED_METADATA_KEYS.filter((key) => Object.prototype.hasOwnProperty.call(stored, key));
+  if (next === null && kept.length === 0) return null;
+  const result = { ...asRecord(next) };
+  for (const key of PROTECTED_METADATA_KEYS) delete result[key];
+  for (const key of kept) result[key] = stored[key];
+  return result;
+}
+
+/** New agents (hires, duplicates) never inherit run-control or drain-after state. */
+export function stripRunControlMetadata<T>(metadata: T): T {
+  if (!metadata || typeof metadata !== "object" || Array.isArray(metadata)) return metadata;
+  const record = metadata as JsonRecord;
+  if (!PROTECTED_METADATA_KEYS.some((key) => Object.prototype.hasOwnProperty.call(record, key))) return metadata;
+  const result = { ...record };
+  for (const key of PROTECTED_METADATA_KEYS) delete result[key];
+  return result as T;
+}
diff --git a/server/src/ppclip/stale-agent-status.ts b/server/src/ppclip/stale-agent-status.ts
new file mode 100644
index 0000000000000000000000000000000000000000..76a40f04422df76b8960b3ce24ac8f6fee460087
--- /dev/null
+++ b/server/src/ppclip/stale-agent-status.ts
@@ -0,0 +1,41 @@
+import { and, eq, sql } from "drizzle-orm";
+import { agents, heartbeatRuns, type Db } from "@paperclipai/db";
+import { publishLiveEvent } from "../services/live-events.js";
+import { ppclipFeature } from "./features.js";
+
+/** An agent row must stay "running" this long without live work before it is repaired. */
+export const STALE_RUNNING_AGENT_GRACE_MS = 30_000;
+
+/**
+ * ppclip FIX-1: an agent can be left "running" when the server stops between
+ * finishing a run and updating the agent. Reset such agents once no queued or
+ * running run remains: to "error" when their latest run failed or timed out,
+ * otherwise to "idle". Live events keep open boards in sync.
+ */
+export async function repairStaleRunningAgents(db: Db, now = new Date()) {
+  if (!ppclipFeature("staleRunningRepair")) return [];
+  const cutoff = new Date(now.getTime() - STALE_RUNNING_AGENT_GRACE_MS);
+  const repaired = await db
+    .update(agents)
+    .set({
+      status: sql`case when (select r.status from ${heartbeatRuns} r
+        where r.agent_id = ${agents.id} order by r.created_at desc limit 1)
+        in ('failed', 'timed_out') then 'error' else 'idle' end`,
+      updatedAt: now,
+    })
+    .where(and(
+      eq(agents.status, "running"),
+      sql`${agents.updatedAt} < ${cutoff.toISOString()}::timestamptz`,
+      sql`not exists (select 1 from ${heartbeatRuns} r where r.agent_id = ${agents.id}
+        and r.status in ('running', 'queued'))`,
+    ))
+    .returning({ id: agents.id, companyId: agents.companyId, status: agents.status });
+  for (const agent of repaired) {
+    publishLiveEvent({
+      companyId: agent.companyId,
+      type: "agent.status",
+      payload: { agentId: agent.id, status: agent.status, reason: "no_live_runs_reconciliation" },
+    });
+  }
+  return repaired;
+}
diff --git a/server/src/ppclip/windows-browser-login.ts b/server/src/ppclip/windows-browser-login.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7e64856479c6f8061559223b82aa2e9f505eaa37
--- /dev/null
+++ b/server/src/ppclip/windows-browser-login.ts
@@ -0,0 +1,108 @@
+import { spawn as spawnProcess } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+
+/**
+ * ppclip Windows browser sign-in terminal.
+ *
+ * Official runs `claude setup-token` and `codex login --device-auth` inside a
+ * terminal made by Python's `pty` module, which only exists on macOS and Linux.
+ * On Windows this starts the same command in a ConPTY through @lydell/node-pty
+ * (prebuilt, loaded only on win32) and hands the output to official's parsers.
+ *
+ * ConPTY repaints the screen with cursor-position codes instead of newlines, and
+ * the parsers read lines, so row changes are turned back into line breaks. The
+ * terminal is very wide so a long sign-in URL never wraps.
+ *
+ * Provider output may contain secrets: it is only passed to `onData`, never logged.
+ */
+
+export type WindowsLoginTerminal = {
+  start(executable: string, args: string[], env: NodeJS.ProcessEnv, onData: (chunk: string) => void): Promise<{ exitCode: number | null }>;
+  write(input: string): void;
+  stop(): void;
+};
+
+const COLUMNS = 1000;
+const ROWS = 50;
+
+/** Finds `name` on PATH using PATHEXT, as cmd.exe would. Absolute paths are kept. */
+export function resolveWindowsExecutable(name: string, env: NodeJS.ProcessEnv): string | null {
+  const exts = (env.PATHEXT ?? ".COM;.EXE;.BAT;.CMD").split(";").filter(Boolean);
+  const candidates = (base: string) => path.extname(base) ? [base] : exts.map((ext) => base + ext.toLowerCase());
+  if (path.isAbsolute(name)) return candidates(name).find((file) => fs.existsSync(file)) ?? null;
+  const pathKey = Object.keys(env).find((key) => key.toLowerCase() === "path") ?? "PATH";
+  for (const dir of (env[pathKey] ?? "").split(path.delimiter).filter(Boolean)) {
+    const found = candidates(path.join(dir, name)).find((file) => fs.existsSync(file));
+    if (found) return found;
+  }
+  return null;
+}
+
+/**
+ * Turns ConPTY cursor-row moves into newlines so official's line parsers can read
+ * the output. It also drops OSC 8 hyperlink markers: ConPTY moves the opening
+ * marker onto the line before the printed URL, and official's cleanup would then
+ * fold the URL onto that line. The URL itself is still printed as plain text.
+ */
+export function createConptyLineRestorer() {
+  let row = 1;
+  return (chunk: string) => chunk.replace(/\x1b\]8;[^\x07\x1b]*(?:\x07|\x1b\\)/g, "").replace(/\x1b\[(\d*)(?:;(\d*))?H|\x1b\[(\d*)B/g, (match, cupRow, _cupCol, down) => {
+    if (down !== undefined) {
+      row += Number(down || 1);
+      return "\n".repeat(Number(down || 1));
+    }
+    const next = Number(cupRow || 1);
+    const lines = next > row ? "\n".repeat(next - row) : next < row ? "\n" : "";
+    row = next;
+    return lines;
+  });
+}
+
+/**
+ * Ends the sign-in process tree without blocking. node-pty's kill() closes the
+ * ConPTY synchronously, and that blocks Node's event loop while the CLI's child
+ * processes still hold the terminal, so the tree is ended first and kill() is
+ * only a fallback.
+ */
+function endProcessTree(pty: { pid: number; kill(): void }, exited: () => boolean) {
+  const taskkill = spawnProcess("taskkill", ["/PID", String(pty.pid), "/T", "/F"], { windowsHide: true, stdio: "ignore" });
+  taskkill.on("error", () => {});
+  setTimeout(() => {
+    if (exited()) return;
+    try { pty.kill(); } catch { /* already exited */ }
+  }, 3000).unref();
+}
+
+export function createWindowsLoginTerminal(): WindowsLoginTerminal {
+  let pty: { pid: number; write(data: string): void; kill(): void } | null = null;
+  let stopped = false;
+  return {
+    async start(executable, args, env, onData) {
+      const { spawn } = await import("@lydell/node-pty");
+      const resolved = resolveWindowsExecutable(executable, env);
+      if (!resolved) throw new Error("Sign-in command not found");
+      // .cmd/.bat shims need cmd.exe; real executables run directly.
+      const viaShell = /\.(cmd|bat)$/i.test(resolved);
+      const file = viaShell ? (env.ComSpec ?? "cmd.exe") : resolved;
+      const argv = viaShell ? ["/d", "/s", "/c", resolved, ...args] : args;
+      const restore = createConptyLineRestorer();
+      return new Promise((resolve) => {
+        const child = spawn(file, argv, {
+          name: "xterm-256color", cols: COLUMNS, rows: ROWS,
+          env: Object.fromEntries(Object.entries(env).filter((entry): entry is [string, string] => typeof entry[1] === "string")),
+        });
+        pty = child;
+        child.onData((data) => onData(restore(data)));
+        child.onExit(({ exitCode }) => { pty = null; resolve({ exitCode }); });
+        if (stopped) endProcessTree(child, () => pty === null);
+      });
+    },
+    write(input) { pty?.write(input); },
+    stop() {
+      if (stopped) return;
+      stopped = true;
+      if (pty) endProcessTree(pty, () => pty === null);
+    },
+  };
+}
