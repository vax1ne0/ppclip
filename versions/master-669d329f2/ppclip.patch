@@ -0,0 +1,55 @@
+import { useMutation } from "@tanstack/react-query";
+import type { Agent } from "@paperclipai/shared";
+import { CirclePause, Loader2 } from "lucide-react";
+import { runControlsApi } from "./api";
+import { useInvalidateRunControls, useRunControls } from "./useRunControls";
+import { usePpclipFeature } from "@/ppclip/features/store";
+
+/**
+ * ppclip RUN-2: "Drain after next run" in an agent's actions menu. When armed,
+ * the whole team drains as soon as this agent's next run starts. The server
+ * checks eligibility (idle, waiting only on another agent, no human decision
+ * pending) and explains a refusal. Hidden while run controls are off.
+ */
+/** ppclip module switch (Settings → ppclip): runControls. */
+export function DrainAfterMenuItem(props: Parameters<typeof DrainAfterMenuItemContent>[0]) {
+  return usePpclipFeature("runControls") ? <DrainAfterMenuItemContent {...props} /> : null;
+}
+
+function DrainAfterMenuItemContent({
+  agent,
+  onDone,
+  onError,
+}: {
+  agent: Pick<Agent, "id" | "companyId" | "status">;
+  onDone?: () => void;
+  onError?: (message: string) => void;
+}) {
+  const overview = useRunControls(agent.companyId);
+  const invalidate = useInvalidateRunControls(agent.companyId);
+  const row = overview.data?.agents.find((entry) => entry.agentId === agent.id);
+  const armed = row?.drainAfterArmed === true;
+  const mutation = useMutation({
+    mutationFn: () => runControlsApi.setDrainAfter(agent.companyId, agent.id, !armed),
+    onSuccess: () => onDone?.(),
+    onError: (error) => onError?.(error instanceof Error ? error.message : "Drain after failed"),
+    onSettled: invalidate,
+  });
+  if (!overview.data?.enabled || !row || agent.status === "terminated") return null;
+  const otherArmed = !armed && overview.data.team?.drainAfterAgentId != null;
+  if (!armed && (row.draining || otherArmed)) return null;
+
+  return (
+    <button
+      className="flex items-center gap-2 w-full px-2 py-1.5 text-xs rounded hover:bg-accent/50"
+      disabled={mutation.isPending}
+      onClick={() => mutation.mutate()}
+      title={armed
+        ? "Cancel the planned team drain."
+        : "When this agent starts its next run, drain the whole team: running work finishes and nothing new starts."}
+    >
+      {mutation.isPending ? <Loader2 className="h-3 w-3 animate-spin" /> : <CirclePause className="h-3 w-3" />}
+      {armed ? "Cancel drain after" : "Drain after next run"}
+    </button>
+  );
+}
diff --git a/ui/src/ppclip/run-controls/RunControlsSettingsSection.tsx b/ui/src/ppclip/run-controls/RunControlsSettingsSection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4d87324ef2c2f7a7044cec74242bc6efe94d9efe
--- /dev/null
+++ b/ui/src/ppclip/run-controls/RunControlsSettingsSection.tsx
@@ -0,0 +1,63 @@
+import { useMutation } from "@tanstack/react-query";
+import { ToggleField } from "@/components/agent-config-primitives";
+import { runControlsApi } from "./api";
+import { useInvalidateRunControls, useRunControls } from "./useRunControls";
+import { usePpclipFeature } from "@/ppclip/features/store";
+
+/**
+ * ppclip: Company Settings section for the run-controls master switch. Off by
+ * default. Turning it off hides every run control and clears all agents' daily
+ * run limits, so agents run unlimited.
+ */
+/** ppclip module switch (Settings → ppclip): runControls. */
+export function RunControlsSettingsSection(props: Parameters<typeof RunControlsSettingsSectionContent>[0]) {
+  return usePpclipFeature("runControls") ? <RunControlsSettingsSectionContent {...props} /> : null;
+}
+
+function RunControlsSettingsSectionContent({ companyId }: { companyId: string }) {
+  const overview = useRunControls(companyId);
+  const invalidate = useInvalidateRunControls(companyId);
+  const mutation = useMutation({
+    mutationFn: (enabled: boolean) => runControlsApi.setEnabled(companyId, enabled),
+    onSettled: invalidate,
+  });
+  const enabled = mutation.isPending ? mutation.variables === true : overview.data?.enabled === true;
+
+  function handleChange(next: boolean) {
+    if (!next) {
+      const confirmed = window.confirm(
+        "Turn off run controls? Every agent's daily run limit is removed, Unlimited, Drain and Drain after are cleared, and agents run without limits.",
+      );
+      if (!confirmed) return;
+    }
+    mutation.mutate(next);
+  }
+
+  return (
+    <div className="max-w-2xl space-y-4" data-testid="ppclip-run-controls-settings">
+      <div className="text-xs font-medium text-muted-foreground uppercase tracking-wide">
+        Run controls
+      </div>
+      <div className="space-y-2">
+        <ToggleField
+          label="Enable run controls"
+          hint="Shows daily runs left on the Agents page and the team Unlimited, Drain, Resume and Drain after actions. Turning this off removes every agent's daily run limit."
+          checked={enabled}
+          onChange={handleChange}
+          toggleTestId="ppclip-run-controls-toggle"
+        />
+        {mutation.isError && (
+          <p className="text-xs text-destructive" role="alert">
+            {mutation.error instanceof Error ? mutation.error.message : "Failed to change run controls"}
+          </p>
+        )}
+        {mutation.isSuccess && !mutation.data.enabled && mutation.data.clearedAgentIds.length > 0 && (
+          <p className="text-xs text-muted-foreground" role="status">
+            Removed run limits from {mutation.data.clearedAgentIds.length} agent
+            {mutation.data.clearedAgentIds.length === 1 ? "" : "s"}.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/ui/src/ppclip/run-controls/TeamRunControls.tsx b/ui/src/ppclip/run-controls/TeamRunControls.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1ddfcc0b2a5a5d908c1e67f3f2895b1bb255f9ad
--- /dev/null
+++ b/ui/src/ppclip/run-controls/TeamRunControls.tsx
@@ -0,0 +1,126 @@
+import { useState } from "react";
+import { useMutation } from "@tanstack/react-query";
+import type { Agent } from "@paperclipai/shared";
+import { CirclePause, Infinity as InfinityIcon, Loader2, Play, X } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { runControlsApi } from "./api";
+import { drainLabel, unlimitedLabel } from "./display";
+import { useInvalidateRunControls, useRunControls } from "./useRunControls";
+import { usePpclipFeature } from "@/ppclip/features/store";
+
+type Action = "unlimited" | "drain" | "resume" | "cancel-drain-after";
+
+/**
+ * ppclip RUN-1/RUN-2: team Unlimited / Drain / Resume for the Agents page header,
+ * plus the armed "Drain after" notice. Renders nothing while the company's
+ * run-controls switch is off.
+ */
+/** ppclip module switch (Settings → ppclip): runControls. */
+export function TeamRunControls(props: Parameters<typeof TeamRunControlsContent>[0]) {
+  return usePpclipFeature("runControls") ? <TeamRunControlsContent {...props} /> : null;
+}
+
+function TeamRunControlsContent({ companyId, agents }: { companyId: string; agents: Agent[] }) {
+  const overview = useRunControls(companyId);
+  const invalidate = useInvalidateRunControls(companyId);
+  const [notice, setNotice] = useState<string | null>(null);
+  const team = overview.data?.enabled ? overview.data.team : null;
+
+  const mutation = useMutation({
+    mutationFn: async (action: Action): Promise<string | null> => {
+      if (!team) return null;
+      if (action === "unlimited") {
+        await runControlsApi.setUnlimited(companyId, team.unlimited !== "on");
+        return null;
+      }
+      if (action === "drain") {
+        await runControlsApi.drain(companyId);
+        return null;
+      }
+      if (action === "cancel-drain-after") {
+        if (team.drainAfterAgentId) await runControlsApi.setDrainAfter(companyId, team.drainAfterAgentId, false);
+        return null;
+      }
+      const result = await runControlsApi.resume(companyId);
+      const skipped = result.wakes.skipped.length;
+      if (result.wakes.accepted === 0 && skipped === 0) return "No assigned work to resume. Agents accept new work again.";
+      return `${result.wakes.accepted} task${result.wakes.accepted === 1 ? "" : "s"} resumed${skipped ? `, ${skipped} skipped` : ""}.`;
+    },
+    onMutate: () => setNotice(null),
+    onSuccess: (message) => setNotice(message),
+    onSettled: invalidate,
+  });
+
+  if (!team) return null;
+  const busy = mutation.isPending ? mutation.variables : null;
+  const draining = team.drain !== "off";
+  const armedAgent = team.drainAfterAgentId ? agents.find((agent) => agent.id === team.drainAfterAgentId) : null;
+
+  return (
+    <div className="flex flex-wrap items-center gap-2" data-testid="ppclip-team-run-controls">
+      {team.drainAfterAgentId && (
+        <span className="flex items-center gap-1 text-xs text-muted-foreground" role="status">
+          Drain after {armedAgent?.name ?? "agent"}: waiting for its next run
+          <Button
+            size="icon-xs"
+            variant="ghost"
+            aria-label="Cancel drain after"
+            disabled={busy !== null}
+            onClick={() => mutation.mutate("cancel-drain-after")}
+          >
+            <X className="h-3 w-3" />
+          </Button>
+        </span>
+      )}
+      <Button
+        size="sm"
+        variant={team.unlimited === "on" ? "secondary" : "outline"}
+        aria-pressed={team.unlimited === "on"}
+        disabled={busy !== null}
+        onClick={() => mutation.mutate("unlimited")}
+        title={team.unlimited === "on"
+          ? "Turn off unlimited runs. Daily limits come back, and runs made while unlimited don't count against today's allowance."
+          : "Lift every agent's daily run limit until you turn this off. Runs made meanwhile don't use up today's allowance."}
+      >
+        {busy === "unlimited" ? <Loader2 className="h-3.5 w-3.5 mr-1.5 animate-spin" /> : <InfinityIcon className="h-3.5 w-3.5 mr-1.5" />}
+        Unlimited: {unlimitedLabel(team)}
+      </Button>
+      <Button
+        size="sm"
+        variant={draining ? "secondary" : "outline"}
+        aria-pressed={draining}
+        data-drain-state={team.drain}
+        disabled={busy !== null || team.drain === "draining" || team.drain === "drained"}
+        onClick={() => mutation.mutate("drain")}
+        title={team.drain === "drained"
+          ? "The team is stopped. Click Resume to allow new work."
+          : team.drain === "draining"
+            ? "Current runs are finishing; nothing new starts."
+            : "Drain: let current runs finish, then start nothing new."}
+      >
+        {busy === "drain" || team.drain === "draining"
+          ? <Loader2 className="h-3.5 w-3.5 mr-1.5 animate-spin" />
+          : <CirclePause className="h-3.5 w-3.5 mr-1.5" />}
+        <span aria-live="polite">{team.drain === "mixed" ? "Drain all" : drainLabel(team)}</span>
+      </Button>
+      {(draining || team.drainAfterAgentId) && (
+        <Button
+          size="sm"
+          variant="outline"
+          disabled={busy !== null}
+          onClick={() => mutation.mutate("resume")}
+          title="Resume: restore each agent's own run limit and wake one assigned task per agent."
+        >
+          {busy === "resume" ? <Loader2 className="h-3.5 w-3.5 mr-1.5 animate-spin" /> : <Play className="h-3.5 w-3.5 mr-1.5" />}
+          Resume
+        </Button>
+      )}
+      {notice && <span role="status" className="text-xs text-muted-foreground">{notice}</span>}
+      {mutation.isError && (
+        <span role="alert" className="text-xs text-destructive">
+          {mutation.error instanceof Error ? mutation.error.message : "Run control failed"}
+        </span>
+      )}
+    </div>
+  );
+}
