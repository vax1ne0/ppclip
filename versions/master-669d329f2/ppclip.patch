+++ b/ui/src/ppclip/run-controls/api.ts
@@ -0,0 +1,49 @@
+import { api } from "@/api/client";
+
+/** Mirrors server/src/ppclip/run-controls/service.ts. */
+export type AgentRunAllowance = {
+  agentId: string;
+  /** The agent's normal daily cap (null = no cap); today's credit is not included. */
+  cap: number | null;
+  usedToday: number;
+  /** Runs made while Unlimited was on that do not count today. */
+  credit: number;
+  /** Runs left today, credit included (null = no cap). */
+  left: number | null;
+  unlimited: boolean;
+  draining: boolean;
+  drainState: "draining" | "drained" | null;
+  liveRuns: number;
+  drainAfterArmed: boolean;
+};
+
+export type TeamRunControlState = {
+  unlimited: "on" | "off" | "mixed";
+  drain: "off" | "draining" | "drained" | "mixed";
+  hasLiveWork: boolean;
+  drainAfterAgentId: string | null;
+};
+
+export type RunControlsOverview = {
+  enabled: boolean;
+  day: string;
+  resetsAt: string;
+  team: TeamRunControlState | null;
+  agents: AgentRunAllowance[];
+};
+
+export type ResumeResult = { agentIds: string[]; wakes: { accepted: number; skipped: string[] } };
+
+const base = (companyId: string) => `/companies/${companyId}/ppclip/run-controls`;
+
+export const runControlsApi = {
+  overview: (companyId: string) => api.get<RunControlsOverview>(base(companyId)),
+  setEnabled: (companyId: string, enabled: boolean) =>
+    api.put<{ enabled: boolean; changed: boolean; clearedAgentIds: string[] }>(base(companyId), { enabled }),
+  setUnlimited: (companyId: string, enabled: boolean) =>
+    api.post<{ agentIds: string[] }>(`${base(companyId)}/unlimited`, { enabled }),
+  drain: (companyId: string) => api.post<{ agentIds: string[] }>(`${base(companyId)}/drain`, {}),
+  resume: (companyId: string) => api.post<ResumeResult>(`${base(companyId)}/resume`, {}),
+  setDrainAfter: (companyId: string, agentId: string, armed: boolean) =>
+    api.post<{ agentId: string; armed: boolean; changed: boolean }>(`${base(companyId)}/drain-after`, { agentId, armed }),
+};
diff --git a/ui/src/ppclip/run-controls/display.ts b/ui/src/ppclip/run-controls/display.ts
new file mode 100644
index 0000000000000000000000000000000000000000..78c1ddd65f198174eaff681db8356a71b80df28c
--- /dev/null
+++ b/ui/src/ppclip/run-controls/display.ts
@@ -0,0 +1,36 @@
+import type { AgentRunAllowance, TeamRunControlState } from "./api";
+
+export type RunsLeftTone = "muted" | "warning" | "danger" | "draining" | "drained";
+
+/** What the roster shows for one agent's daily allowance. */
+export function runsLeftDisplay(row: AgentRunAllowance): { label: string; tone: RunsLeftTone } {
+  if (row.drainState === "draining") return { label: "Draining", tone: "draining" };
+  if (row.drainState === "drained") return { label: "Drained", tone: "drained" };
+  if (row.left === null || row.cap === null) return { label: "∞", tone: "muted" };
+  const tone: RunsLeftTone = row.left === 0 ? "danger" : row.left <= 2 ? "warning" : "muted";
+  return { label: `${row.left}/${row.cap}`, tone };
+}
+
+export function runsLeftTitle(row: AgentRunAllowance, resetsAt: string) {
+  if (row.drainState === "draining") return `Draining: current runs can finish; new runs are stopped. ${row.usedToday} run(s) today.`;
+  if (row.drainState === "drained") return `Drained: no live runs and new runs are stopped until Resume. ${row.usedToday} run(s) today.`;
+  const reset = new Date(resetsAt).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
+  if (row.cap === null) {
+    return `${row.unlimited ? "Unlimited runs are on." : "No daily run cap."} ${row.usedToday} run(s) today (UTC day).`;
+  }
+  const counted = Math.max(0, row.usedToday - row.credit);
+  const credit = row.credit > 0
+    ? ` ${row.credit} run${row.credit === 1 ? "" : "s"} made while unlimited ${row.credit === 1 ? "doesn't" : "don't"} count.`
+    : "";
+  return `${counted} of ${row.cap} daily runs used.${credit} The cap counts runs started in the current UTC day and resets at ${reset} your time. Queued runs do not count.`;
+}
+
+export function unlimitedLabel(team: TeamRunControlState) {
+  return team.unlimited === "on" ? "On" : team.unlimited === "mixed" ? "Mixed" : "Off";
+}
+
+export function drainLabel(team: TeamRunControlState) {
+  if (team.drain === "draining") return "Draining";
+  if (team.drain === "drained") return "Drained";
+  return "Drain";
+}
diff --git a/ui/src/ppclip/run-controls/run-controls.test.tsx b/ui/src/ppclip/run-controls/run-controls.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8618e102ae8880f02b709c6ba243476bb5a8c869
--- /dev/null
+++ b/ui/src/ppclip/run-controls/run-controls.test.tsx
@@ -0,0 +1,156 @@
+// @vitest-environment jsdom
+
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Agent } from "@paperclipai/shared";
+import { TooltipProvider } from "@/components/ui/tooltip";
+import type { AgentRunAllowance, RunControlsOverview } from "./api";
+import { runsLeftDisplay, runsLeftTitle } from "./display";
+
+const mockApi = vi.hoisted(() => ({
+  overview: vi.fn(),
+  setEnabled: vi.fn(),
+  setUnlimited: vi.fn(),
+  drain: vi.fn(),
+  resume: vi.fn(),
+  setDrainAfter: vi.fn(),
+}));
+vi.mock("./api", () => ({ runControlsApi: mockApi }));
+
+import { TeamRunControls } from "./TeamRunControls";
+import { DailyRunsLeft } from "./DailyRunsLeft";
+import { DrainAfterMenuItem } from "./DrainAfterMenuItem";
+import { RunControlsSettingsSection } from "./RunControlsSettingsSection";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const companyId = "company-1";
+const row = (overrides: Partial<AgentRunAllowance> = {}): AgentRunAllowance => ({
+  agentId: "agent-1", cap: 5, usedToday: 2, credit: 0, left: 3, unlimited: false, draining: false,
+  drainState: null, liveRuns: 0, drainAfterArmed: false, ...overrides,
+});
+const enabledOverview = (overrides: Partial<RunControlsOverview> = {}): RunControlsOverview => ({
+  enabled: true, day: "2026-10-16", resetsAt: "2026-10-17T00:00:00.000Z",
+  team: { unlimited: "off", drain: "off", hasLiveWork: false, drainAfterAgentId: null },
+  agents: [row()], ...overrides,
+});
+const disabledOverview: RunControlsOverview = {
+  enabled: false, day: "2026-10-16", resetsAt: "2026-10-17T00:00:00.000Z", team: null, agents: [],
+};
+const agent = { id: "agent-1", companyId, name: "Alice", status: "idle" } as Agent;
+
+let container: HTMLDivElement;
+let root: Root;
+
+async function render(node: React.ReactNode) {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  await act(async () => {
+    root.render(<QueryClientProvider client={client}><TooltipProvider>{node}</TooltipProvider></QueryClientProvider>);
+  });
+  // Let the overview query resolve.
+  await act(async () => { await new Promise((resolve) => setTimeout(resolve, 0)); });
+}
+
+function surfaces() {
+  return (
+    <>
+      <TeamRunControls companyId={companyId} agents={[agent]} />
+      <DailyRunsLeft companyId={companyId} agentId="agent-1" />
+      <DrainAfterMenuItem agent={agent} />
+    </>
+  );
+}
+
+beforeEach(() => {
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  root = createRoot(container);
+  for (const fn of Object.values(mockApi)) fn.mockReset();
+});
+
+afterEach(async () => {
+  await act(async () => root.unmount());
+  container.remove();
+});
+
+describe("run controls visibility", () => {
+  it("hides every run control while the switch is off", async () => {
+    mockApi.overview.mockResolvedValue(disabledOverview);
+    await render(surfaces());
+    expect(mockApi.overview).toHaveBeenCalledWith(companyId);
+    expect(container.textContent).toBe("");
+    expect(container.querySelector("[data-testid='ppclip-team-run-controls']")).toBeNull();
+    expect(container.querySelector("[data-testid='ppclip-daily-runs-left']")).toBeNull();
+  });
+
+  it("shows team actions, runs left and drain after once the switch is on", async () => {
+    mockApi.overview.mockResolvedValue(enabledOverview());
+    await render(surfaces());
+    expect(container.querySelector("[data-testid='ppclip-team-run-controls']")).not.toBeNull();
+    expect(container.textContent).toContain("Unlimited: Off");
+    expect(container.textContent).toContain("Drain");
+    expect(container.textContent).not.toContain("Resume");
+    expect(container.querySelector("[data-testid='ppclip-daily-runs-left']")?.textContent).toContain("3/5");
+    expect(container.textContent).toContain("Drain after next run");
+  });
+
+  it("shows Resume and the armed plan while draining", async () => {
+    mockApi.overview.mockResolvedValue(enabledOverview({
+      team: { unlimited: "off", drain: "drained", hasLiveWork: false, drainAfterAgentId: null },
+      agents: [row({ draining: true, drainState: "drained", cap: 0, left: 0 })],
+    }));
+    await render(surfaces());
+    expect(container.textContent).toContain("Drained");
+    expect(container.textContent).toContain("Resume");
+    // A draining agent cannot be armed.
+    expect(container.textContent).not.toContain("Drain after next run");
+  });
+
+  it("calls the team endpoints", async () => {
+    mockApi.overview.mockResolvedValue(enabledOverview());
+    mockApi.setUnlimited.mockResolvedValue({ agentIds: ["agent-1"] });
+    await render(<TeamRunControls companyId={companyId} agents={[agent]} />);
+    const unlimited = [...container.querySelectorAll("button")].find((button) => button.textContent?.includes("Unlimited"));
+    await act(async () => { unlimited!.click(); });
+    expect(mockApi.setUnlimited).toHaveBeenCalledWith(companyId, true);
+  });
+});
+
+describe("run controls settings", () => {
+  it("turns the switch on", async () => {
+    mockApi.overview.mockResolvedValue(disabledOverview);
