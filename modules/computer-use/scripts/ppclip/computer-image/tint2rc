# Always-visible window list. No application launchers: Chromium is owned by
# control.py and must retain its managed profile, proxy and debugging pipe.
panel_items = T
panel_size = 100% 36
panel_position = bottom center horizontal
panel_padding = 6 3 6
panel_margin = 0 0
panel_layer = top
panel_background_id = 1
strut_policy = follow_size
autohide = 0
wm_menu = 1

rounded = 0
border_width = 0
background_color = #202124 100
border_color = #202124 100

rounded = 4
border_width = 0
background_color = #41454b 100
border_color = #41454b 100

taskbar_mode = single_desktop
taskbar_hide_different_desktop = 0
taskbar_hide_different_monitor = 0
taskbar_padding = 0 0 6
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 300 30
task_padding = 8 3 6
task_font = DejaVu Sans 10
task_font_color = #eeeeee 100
task_active_font_color = #ffffff 100
task_iconified_font_color = #cccccc 100
task_background_id = 1
task_active_background_id = 2
task_iconified_background_id = 1
task_tooltip = 1
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none
